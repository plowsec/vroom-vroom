[Unit]
Description=bulwark network helper (bridged / host-only VM networking)
After=network-online.target

[Service]
ExecStart=/usr/local/libexec/bulwark-netd /etc/bulwark/netd.toml
Restart=on-failure
# Needs CAP_NET_ADMIN for tap/bridge; nothing else.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_CHOWN
AmbientCapabilities=CAP_NET_ADMIN CAP_CHOWN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RuntimeDirectory=bulwark
ReadWritePaths=/run/bulwark
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
