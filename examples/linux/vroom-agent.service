# vroom guest agent, system part: owns the host channel (root only),
# syncs the clock, handles clean shutdown, relays clipboard/resolution to
# the session helper of the user on screen. Updates from the host are
# staged in /var/lib/vroom-agent and installed by vroom-agent-update.
[Unit]
Description=vroom guest agent
After=systemd-udevd.service

[Service]
ExecStart=/usr/local/bin/vroom-agent --service
Restart=always
RestartSec=2
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_TIME
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run
StateDirectory=vroom-agent
StateDirectoryMode=0700
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
