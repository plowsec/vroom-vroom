+/* macOS's GLSL compiler (OpenGL 4.1) rejects #extension lines it doesn't
+ * list, even for what its own version has built in. Rewrite the header
+ * at the host's version, without those extensions. */
+static void use_host_glsl_version(struct vrend_strbuf *sb, int host_ver)
+{
+   char *out = malloc(sb->size + 1);
+   size_t n = 0;
+   const char *p = sb->buf;
+   int ver;
+
+   if (!out)
+      return;
+   while (*p) {
+      const char *eol = strchr(p, '\n');
+      size_t len = eol ? (size_t)(eol - p + 1) : strlen(p);
+      bool keep = true;
+
+      if (sscanf(p, "#version %d", &ver) == 1 && ver < host_ver && len == 13) {
+         n += snprintf(out + n, 14, "#version %d\n", host_ver);
+         keep = false;
+      } else if (!strncmp(p, "#extension GL_", 14)) {
+         for (unsigned i = 0; i < ARRAY_SIZE(glsl_core_exts); i++) {
+            size_t l = strlen(glsl_core_exts[i].name);
+            if (glsl_core_exts[i].core <= host_ver &&
+                !strncmp(p + 14, glsl_core_exts[i].name, l) && p[14 + l] == ' ')
+               keep = false;
+         }
+      }
+      if (keep) {
+         memcpy(out + n, p, len);
+         n += len;
+      }
+      p += len;
+   }
+   out[n] = 0;
+   memcpy(sb->buf, out, n + 1);
+   sb->size = n;
+   free(out);
+}
