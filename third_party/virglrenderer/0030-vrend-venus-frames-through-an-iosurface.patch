diff --git a/src/vrend/vrend_shm_surface.h b/src/vrend/vrend_shm_surface.h
new file mode 100644
--- /dev/null
+++ b/src/vrend/vrend_shm_surface.h
@@ -0,0 +1,92 @@
+/*
+ * vroom: a Venus window's frame shown through macOS's OpenGL with no CPU
+ * copy.
+ * SPDX-License-Identifier: MIT
+ *
+ * A Vulkan window's frame sits in shared memory the render worker made and
+ * vrend maps read only.  macOS's OpenGL can't take that memory as a texture,
+ * and copying it in with glTexSubImage2D costs the GPU process's GL thread
+ * about 0.5 ms a frame at 1280x800 and 1.9 ms at 2560x1600 (the driver
+ * retiles it on the CPU).  Metal can take the memory as a buffer, and Metal
+ * and OpenGL can share an IOSurface: Metal copies the frame into an IOSurface
+ * on the GPU, GL sees the IOSurface as a rectangle texture and copies it into
+ * the resource's texture, on the GPU too.  Everything stays in the GPU
+ * process; nothing new crosses processes.
+ */
+#ifndef VREND_SHM_SURFACE_H
+#define VREND_SHM_SURFACE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+struct vrend_shm_surface;
+
+#ifdef __APPLE__
+
+/* A surface for a `width` x `height` frame of 4-byte pixels at `offset` in
+ * `map` (a read-only mapping, page aligned, `map_size` bytes, whole pages),
+ * rows `stride` bytes apart, laid out as IOSurface pixel format `fourcc`
+ * ('BGRA' or 'RGBA'; macOS's GL takes 'BGRA' only).  The caller has checked
+ * the frame lies in the map.  NULL if Metal can't do it (then the caller
+ * copies as before). */
+struct vrend_shm_surface *
+vrend_shm_surface_create(const void *map,
+                         size_t map_size,
+                         size_t offset,
+                         uint32_t stride,
+                         uint32_t width,
+                         uint32_t height,
+                         uint32_t fourcc);
+
+/* its IOSurfaceRef (owned by the surface) */
+void *
+vrend_shm_surface_iosurface(struct vrend_shm_surface *s);
+
+/* Copy the frame from the memory into the IOSurface, and wait for the GPU
+ * to finish it.  False on a Metal error. */
+bool
+vrend_shm_surface_update(struct vrend_shm_surface *s);
+
+void
+vrend_shm_surface_destroy(struct vrend_shm_surface *s);
+
+#else
+
+static inline struct vrend_shm_surface *
+vrend_shm_surface_create(const void *map,
+                         size_t map_size,
+                         size_t offset,
+                         uint32_t stride,
+                         uint32_t width,
+                         uint32_t height,
+                         uint32_t fourcc)
+{
+   (void)map, (void)map_size, (void)offset, (void)stride;
+   (void)width, (void)height, (void)fourcc;
+   return NULL;
+}
+
+static inline void *
+vrend_shm_surface_iosurface(struct vrend_shm_surface *s)
+{
+   (void)s;
+   return NULL;
+}
+
+static inline bool
+vrend_shm_surface_update(struct vrend_shm_surface *s)
+{
+   (void)s;
+   return false;
+}
+
+static inline void
+vrend_shm_surface_destroy(struct vrend_shm_surface *s)
+{
+   (void)s;
+}
+
+#endif
+
+#endif /* VREND_SHM_SURFACE_H */
diff --git a/src/vrend/vrend_shm_surface.m b/src/vrend/vrend_shm_surface.m
new file mode 100644
--- /dev/null
+++ b/src/vrend/vrend_shm_surface.m
@@ -0,0 +1,144 @@
+/*
+ * vroom: a Venus window's frame shown through macOS's OpenGL with no CPU
+ * copy (see vrend_shm_surface.h).
+ * SPDX-License-Identifier: MIT
+ */
+#include "vrend_shm_surface.h"
+
+#include <IOSurface/IOSurface.h>
+#include <Metal/Metal.h>
+#include <pthread.h>
+#include <unistd.h>
+
+struct vrend_shm_surface {
+   id<MTLBuffer> buffer;
+   id<MTLTexture> texture;
+   IOSurfaceRef surface;
+   size_t offset;
+   uint32_t stride, width, height;
+};
+
+static id<MTLDevice> vrend_shm_device;
+static id<MTLCommandQueue> vrend_shm_queue;
+
+static void
+vrend_shm_surface_init(void)
+{
+   vrend_shm_device = MTLCreateSystemDefaultDevice();
+   if (vrend_shm_device)
+      vrend_shm_queue = [vrend_shm_device newCommandQueue];
+}
+
+struct vrend_shm_surface *
+vrend_shm_surface_create(const void *map,
+                         size_t map_size,
+                         size_t offset,
+                         uint32_t stride,
+                         uint32_t width,
+                         uint32_t height,
+                         uint32_t fourcc)
+{
+   static pthread_once_t once = PTHREAD_ONCE_INIT;
+   pthread_once(&once, vrend_shm_surface_init);
+   if (!vrend_shm_queue)
+      return NULL;
+
+   MTLPixelFormat format;
+   switch (fourcc) {
+   case 'BGRA':
+      format = MTLPixelFormatBGRA8Unorm;
+      break;
+   case 'RGBA':
+      format = MTLPixelFormatRGBA8Unorm;
+      break;
+   default:
+      return NULL;
+   }
+   const size_t page = getpagesize();
+   if (!map || ((uintptr_t)map % page) || !map_size || (map_size % page) || !width ||
+       !height || width > 16384 || height > 16384 || (offset % 4) || (stride % 4) ||
+       stride < width * 4 || offset + (size_t)stride * (height - 1) + width * 4 > map_size)
+      return NULL;
+
+   struct vrend_shm_surface *s = calloc(1, sizeof(*s));
+   if (!s)
+      return NULL;
+   @autoreleasepool {
+      /* The guest's memory, read where it lies: Metal only reads it. */
+      s->buffer = [vrend_shm_device newBufferWithBytesNoCopy:(void *)map
+                                                      length:map_size
+                                                     options:MTLResourceStorageModeShared
+                                                 deallocator:nil];
+      NSDictionary *props = @{
+         (id)kIOSurfaceWidth : @(width),
+         (id)kIOSurfaceHeight : @(height),
+         (id)kIOSurfaceBytesPerElement : @4,
+         (id)kIOSurfacePixelFormat : @(fourcc),
+      };
+      /* not global: it never leaves this process */
+      s->surface = IOSurfaceCreate((__bridge CFDictionaryRef)props);
+      if (s->buffer && s->surface) {
+         MTLTextureDescriptor *desc =
+            [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:format
+                                                               width:width
+                                                              height:height
+                                                           mipmapped:NO];
+         desc.usage = MTLTextureUsageShaderRead;
+         desc.storageMode = MTLStorageModeShared;
+         s->texture = [vrend_shm_device newTextureWithDescriptor:desc iosurface:s->surface plane:0];
+      }
+   }
+   if (!s->texture) {
+      vrend_shm_surface_destroy(s);
+      return NULL;
+   }
+   s->offset = offset;
+   s->stride = stride;
+   s->width = width;
+   s->height = height;
+   return s;
+}
+
+void *
+vrend_shm_surface_iosurface(struct vrend_shm_surface *s)
+{
+   return s ? (void *)s->surface : NULL;
+}
+
+bool
+vrend_shm_surface_update(struct vrend_shm_surface *s)
+{
+   if (!s)
+      return false;
+   @autoreleasepool {
+      id<MTLCommandBuffer> cb = [vrend_shm_queue commandBuffer];
+      id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+      [blit copyFromBuffer:s->buffer
+                 sourceOffset:s->offset
+            sourceBytesPerRow:s->stride
+          sourceBytesPerImage:0
+                   sourceSize:MTLSizeMake(s->width, s->height, 1)
+                    toTexture:s->texture
+             destinationSlice:0
+             destinationLevel:0
+            destinationOrigin:MTLOriginMake(0, 0, 0)];
+      [blit endEncoding];
+      [cb commit];
+      /* GL reads the IOSurface next, on another queue: it must be there */
+      [cb waitUntilCompleted];
+      return cb.status == MTLCommandBufferStatusCompleted;
+   }
+}
+
+void
+vrend_shm_surface_destroy(struct vrend_shm_surface *s)
+{
+   if (!s)
+      return;
+   /* built without ARC */
+   [s->texture release];
+   [s->buffer release];
+   if (s->surface)
+      CFRelease(s->surface);
+   free(s);
+}
