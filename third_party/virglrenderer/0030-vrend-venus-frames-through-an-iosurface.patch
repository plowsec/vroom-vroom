+   }
+   const size_t page = getpagesize();
+   const size_t map_size = (gr->shm_map_size + page - 1) & ~(page - 1);
+   gr->shm_surface = vrend_shm_surface_create(gr->shm_map, map_size, gr->shm_offset,
+                                              gr->shm_stride, gr->base.width0,
+                                              gr->base.height0, 0x42475241 /* 'BGRA' */);
+   if (!gr->shm_surface)
+      return;
+
+   const struct vrend_format_table *tf = &tex_conv_table[gr->base.format];
+   GLint bound;
+   glGetIntegerv(GL_TEXTURE_BINDING_RECTANGLE, &bound);
+   glGenTextures(1, &gr->shm_surface_tex);
+   glBindTexture(GL_TEXTURE_RECTANGLE, gr->shm_surface_tex);
+   int err = tex_image(cgl, GL_TEXTURE_RECTANGLE, tf->internalformat, gr->base.width0,
+                       gr->base.height0, GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV,
+                       vrend_shm_surface_iosurface(gr->shm_surface), 0);
+   glBindTexture(GL_TEXTURE_RECTANGLE, bound);
