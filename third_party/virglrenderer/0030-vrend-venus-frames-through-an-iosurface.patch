+static void vrend_resource_shm_surface_init(struct vrend_resource *gr)
+{
+   static vrend_cgl_tex_image_iosurface_2d tex_image;
+   static vrend_cgl_get_current_context current;
+   static int off = -1;
+   if (off < 0) {
+      const char *e = getenv("VROOM_SHM_COPY");
+      off = e && *e && *e != '0';
+      tex_image = (vrend_cgl_tex_image_iosurface_2d)dlsym(RTLD_DEFAULT, "CGLTexImageIOSurface2D");
+      current = (vrend_cgl_get_current_context)dlsym(RTLD_DEFAULT, "CGLGetCurrentContext");
+   }
+   void *cgl = current ? current() : NULL;
+   if (off || !tex_image || !cgl ||
+       (uint64_t)gr->base.width0 * gr->base.height0 < VREND_SHM_SURFACE_MIN_PIXELS)
+      return;
+
+   switch (gr->base.format) {
+   case VIRGL_FORMAT_B8G8R8A8_UNORM:
+   case VIRGL_FORMAT_B8G8R8X8_UNORM:
+   case VIRGL_FORMAT_B8G8R8A8_SRGB:
+   case VIRGL_FORMAT_B8G8R8X8_SRGB:
+      break;
+   default:
