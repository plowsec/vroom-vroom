diff --git a/src/neptune/npt_overrides_d3d11_immutable.c b/src/neptune/npt_overrides_d3d11_immutable.c
new file mode 100644
--- /dev/null
+++ b/src/neptune/npt_overrides_d3d11_immutable.c
@@ -0,0 +1,122 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * IMMUTABLE resources created without initial data.
+ *
+ * The guest creates IMMUTABLE buffers and textures without initial data
+ * and uploads their contents right after with RESOURCE_UPDATE
+ * (UpdateSubresource on the host).  D3D11 forbids writing an IMMUTABLE
+ * resource, and a backend may rely on it: DXMT tracks no GPU dependencies
+ * on IMMUTABLE resources, so a copy or draw that reads one can run before
+ * the upload has landed and read zeros.  In D2D/XAML apps that left glyph
+ * atlases without their white texel (copied from a 1x1 IMMUTABLE texture),
+ * and text and shapes drawn with them missing.
+ *
+ * An IMMUTABLE resource that arrives without initial data is created
+ * DEFAULT instead: its uploads are then ordered like any other write.
+ */
+
+#include "npt_overrides.h"
+
+#include "neptune-protocol/npt_protocol_host_id3d11device.h"
+
+HRESULT
+npt_override_ID3D11Device_CreateBuffer(
+   UNUSED struct npt_dispatch_context *ctx,
+   struct npt_command_ID3D11Device_CreateBuffer *args,
+   PFN_ID3D11Device_CreateBuffer original)
+{
+   if (args->pDesc && args->pDesc->Usage == D3D11_USAGE_IMMUTABLE &&
+       !args->pInitialData) {
+      D3D11_BUFFER_DESC desc = *args->pDesc;
+      desc.Usage = D3D11_USAGE_DEFAULT;
+      return original(args->_self, &desc, NULL, args->ppBuffer);
+   }
+   return original(args->_self, args->pDesc, args->pInitialData,
+                   args->ppBuffer);
+}
+
+HRESULT
+npt_override_ID3D11Device_CreateTexture1D(
+   UNUSED struct npt_dispatch_context *ctx,
+   struct npt_command_ID3D11Device_CreateTexture1D *args,
+   PFN_ID3D11Device_CreateTexture1D original)
+{
+   if (args->pDesc && args->pDesc->Usage == D3D11_USAGE_IMMUTABLE &&
+       !args->pInitialData) {
+      D3D11_TEXTURE1D_DESC desc = *args->pDesc;
+      desc.Usage = D3D11_USAGE_DEFAULT;
+      return original(args->_self, &desc, NULL, args->ppTexture1D);
+   }
+   return original(args->_self, args->pDesc, args->pInitialData,
+                   args->ppTexture1D);
+}
+
+HRESULT
+npt_override_ID3D11Device_CreateTexture2D(
+   UNUSED struct npt_dispatch_context *ctx,
+   struct npt_command_ID3D11Device_CreateTexture2D *args,
+   PFN_ID3D11Device_CreateTexture2D original)
+{
+   if (args->pDesc && args->pDesc->Usage == D3D11_USAGE_IMMUTABLE &&
+       !args->pInitialData) {
+      D3D11_TEXTURE2D_DESC desc = *args->pDesc;
+      desc.Usage = D3D11_USAGE_DEFAULT;
+      return original(args->_self, &desc, NULL, args->ppTexture2D);
+   }
+   return original(args->_self, args->pDesc, args->pInitialData,
+                   args->ppTexture2D);
+}
+
+HRESULT
+npt_override_ID3D11Device_CreateTexture3D(
+   UNUSED struct npt_dispatch_context *ctx,
+   struct npt_command_ID3D11Device_CreateTexture3D *args,
+   PFN_ID3D11Device_CreateTexture3D original)
+{
+   if (args->pDesc && args->pDesc->Usage == D3D11_USAGE_IMMUTABLE &&
+       !args->pInitialData) {
+      D3D11_TEXTURE3D_DESC desc = *args->pDesc;
+      desc.Usage = D3D11_USAGE_DEFAULT;
+      return original(args->_self, &desc, NULL, args->ppTexture3D);
+   }
+   return original(args->_self, args->pDesc, args->pInitialData,
+                   args->ppTexture3D);
+}
+
+static HRESULT
+override_ID3D11Device3_CreateTexture2D1(
+   UNUSED struct npt_dispatch_context *ctx,
+   struct npt_command_ID3D11Device3_CreateTexture2D1 *args,
+   PFN_ID3D11Device3_CreateTexture2D1 original)
+{
+   if (args->pDesc1 && args->pDesc1->Usage == D3D11_USAGE_IMMUTABLE &&
+       !args->pInitialData) {
+      D3D11_TEXTURE2D_DESC1 desc = *args->pDesc1;
+      desc.Usage = D3D11_USAGE_DEFAULT;
+      return original(args->_self, &desc, NULL, args->ppTexture2D);
+   }
+   return original(args->_self, args->pDesc1, args->pInitialData,
+                   args->ppTexture2D);
+}
+
+static HRESULT
+override_ID3D11Device3_CreateTexture3D1(
+   UNUSED struct npt_dispatch_context *ctx,
+   struct npt_command_ID3D11Device3_CreateTexture3D1 *args,
+   PFN_ID3D11Device3_CreateTexture3D1 original)
+{
+   if (args->pDesc1 && args->pDesc1->Usage == D3D11_USAGE_IMMUTABLE &&
+       !args->pInitialData) {
+      D3D11_TEXTURE3D_DESC1 desc = *args->pDesc1;
+      desc.Usage = D3D11_USAGE_DEFAULT;
+      return original(args->_self, &desc, NULL, args->ppTexture3D);
+   }
+   return original(args->_self, args->pDesc1, args->pInitialData,
+                   args->ppTexture3D);
+}
+
+struct npt_dispatch_id3d11device3_overrides npt_id3d11device3_overrides = {
+   .CreateTexture2D1 = override_ID3D11Device3_CreateTexture2D1,
+   .CreateTexture3D1 = override_ID3D11Device3_CreateTexture3D1,
+};
