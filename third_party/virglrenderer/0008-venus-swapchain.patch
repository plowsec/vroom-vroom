+/* dma_buf is emulated with shm imported as host memory, which only host
+ * visible memory types take (the guest would pick device local otherwise,
+ * and the import would fail). */
+void
+vkr_device_shm_memory_types(struct vkr_device *dev, VkMemoryRequirements *reqs)
+{
+   const VkPhysicalDeviceMemoryProperties *props =
+      &dev->physical_device->memory_properties;
+   uint32_t host = 0;
+   for (uint32_t i = 0; i < props->memoryTypeCount; i++) {
+      if (props->memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)
+         host |= 1u << i;
+   }
+   if (reqs->memoryTypeBits & host)
+      reqs->memoryTypeBits &= host;
+}
