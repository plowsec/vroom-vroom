+                                        void *image_oes);
+
+static uint32_t vrend_shm_epoch = 1;
+
+void vrend_renderer_shm_epoch_next(void)
+{
+   if (++vrend_shm_epoch == 0)
+      vrend_shm_epoch = 1;
+}
+
+/* Copy a Venus blob's current contents into its GL texture, once per
+ * command stream.  Texture unit 0's 2D binding and the unpack state are put
+ * back as they were. */
+static void vrend_resource_shm_refresh(struct vrend_resource *res)
+{
+   if (!res || !res->shm_map || res->shm_epoch == vrend_shm_epoch)
+      return;
+   res->shm_epoch = vrend_shm_epoch;
+
+   const struct vrend_format_table *tf = &tex_conv_table[res->base.format];
+   const unsigned bpp = util_format_get_blocksize(res->base.format);
+   GLint active, bound, pbo, row_length, alignment;
+   glGetIntegerv(GL_ACTIVE_TEXTURE, &active);
+   glActiveTexture(GL_TEXTURE0);
+   glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+   glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &pbo);
+   glGetIntegerv(GL_UNPACK_ROW_LENGTH, &row_length);
+   glGetIntegerv(GL_UNPACK_ALIGNMENT, &alignment);
+
+   glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+   glBindTexture(GL_TEXTURE_2D, res->gl_id);
+   glPixelStorei(GL_UNPACK_ROW_LENGTH, res->shm_stride / bpp);
+   glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+   glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, res->base.width0, res->base.height0,
+                   tf->glformat, tf->gltype, res->shm_map + res->shm_offset);
+
+   glPixelStorei(GL_UNPACK_ALIGNMENT, alignment);
+   glPixelStorei(GL_UNPACK_ROW_LENGTH, row_length);
+   glBindTexture(GL_TEXTURE_2D, bound);
+   glBindBuffer(GL_PIXEL_UNPACK_BUFFER, pbo);
+   glActiveTexture(active);
+}
