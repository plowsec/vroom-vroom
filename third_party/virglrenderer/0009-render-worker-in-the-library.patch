+/* vroom: run one render server context (Venus or Neptune) in this process,
+ * the worker the embedder started for it.  ctx_fd is the worker's end of
+ * the socket pair whose other end went to the proxy (ownership taken, even
+ * on errors); init_flags are VIRGL_RENDERER_NO_VIRGL plus the one backend.
+ * Returns when the context ends (the proxy hung up, or an error, logged).
+ * Only in builds with the worker in the library (macOS, render server in
+ * process mode): look it up with dlsym. */
+VIRGL_EXPORT int virgl_renderer_render_worker_main(int ctx_fd,
+                                                   uint32_t ctx_id,
+                                                   uint32_t init_flags,
+                                                   const char *ctx_name);
