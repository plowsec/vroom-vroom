+
+int virgl_renderer_render_worker_main(int ctx_fd,
+                                      uint32_t ctx_id,
+                                      uint32_t init_flags,
+                                      const char *ctx_name)
+{
+   if (ctx_fd < 0 || !ctx_id) {
+      if (ctx_fd >= 0)
+         close(ctx_fd);
+      return -1;
+   }
+
+   struct render_context_args args = {
+      .valid = true,
+      .init_flags = init_flags,
+      .ctx_id = ctx_id,
+      .ctx_fd = ctx_fd,
+   };
+   if (ctx_name)
+      snprintf(args.ctx_name, sizeof(args.ctx_name), "%s", ctx_name);
+
+   /* takes ctx_fd; false also for the normal end (the proxy hung up) */
+   render_context_main(&args);
+   return 0;
+}
+#endif
