+static struct virgl_context *
+virgl_renderer_snapshot_context(uint32_t ctx_id)
+{
+   struct virgl_context *ctx = virgl_context_lookup(ctx_id);
+   if (!ctx || ctx->capset_id != VIRTGPU_DRM_CAPSET_VENUS || !state.proxy_initialized)
+      return NULL;
+   return ctx;
+}
+
+int virgl_renderer_context_save(uint32_t ctx_id, int *out_fd, uint64_t *out_size)
+{
+   *out_fd = -1;
+   *out_size = 0;
+   struct virgl_context *ctx = virgl_renderer_snapshot_context(ctx_id);
+   if (!ctx)
+      return -EINVAL;
+   const int r = proxy_context_save(ctx, out_fd, out_size);
+   return r < 0 ? -EIO : r;
+}
+
+int virgl_renderer_context_restore(uint32_t ctx_id, int fd, uint64_t size)
+{
+   struct virgl_context *ctx = virgl_renderer_snapshot_context(ctx_id);
+   int r = -EINVAL;
+   if (ctx)
+      r = proxy_context_restore(ctx, fd, size) ? -EIO : 0;
+   close(fd);
+   return r;
+}
+
+int virgl_renderer_context_resume(uint32_t ctx_id)
+{
+   struct virgl_context *ctx = virgl_renderer_snapshot_context(ctx_id);
+   if (!ctx)
+      return -EINVAL;
+   return proxy_context_resume(ctx) ? -EIO : 0;
+}
