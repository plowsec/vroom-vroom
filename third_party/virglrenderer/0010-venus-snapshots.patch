+/* What a snapshot keeps of an image, and transfer usage added where the
+ * format allows it, so its contents can be copied out and back. */
+static struct vkr_image_snap
+vkr_image_snap_prepare(struct vkr_device *dev, VkImageCreateInfo *info)
+{
+   struct vkr_image_snap s = {
+      .device = dev,
+      .format = info->format,
+      .extent = info->extent,
+      .mip_levels = info->mipLevels,
+      .array_layers = info->arrayLayers,
+      .samples = info->samples,
+   };
+   const VkImageCreateFlags odd = VK_IMAGE_CREATE_SPARSE_BINDING_BIT |
+                                  VK_IMAGE_CREATE_DISJOINT_BIT |
+                                  VK_IMAGE_CREATE_SPARSE_RESIDENCY_BIT;
+   s.valid = !(info->flags & odd);
+   if (info->usage & VK_IMAGE_USAGE_TRANSIENT_ATTACHMENT_BIT)
+      return s;
+
+   const VkImageUsageFlags xfer =
+      VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+   if ((info->usage & xfer) == xfer) {
+      s.transfer = true;
+      return s;
+   }
+   struct vkr_physical_device *pd = dev->physical_device;
+   VkFormatProperties props = { 0 };
+   pd->proc_table.GetPhysicalDeviceFormatProperties(pd->base.handle.physical_device,
+                                                    info->format, &props);
+   const VkFormatFeatureFlags have = info->tiling == VK_IMAGE_TILING_LINEAR
+                                        ? props.linearTilingFeatures
+                                        : props.optimalTilingFeatures;
+   const VkFormatFeatureFlags need =
+      VK_FORMAT_FEATURE_TRANSFER_SRC_BIT | VK_FORMAT_FEATURE_TRANSFER_DST_BIT;
+   /* a format list or a usage list of its own would need the same: leave
+    * those images alone */
+   if ((have & need) == need &&
+       !vkr_find_struct(info->pNext, VK_STRUCTURE_TYPE_IMAGE_STENCIL_USAGE_CREATE_INFO)) {
+      info->usage |= xfer;
+      s.transfer = true;
+   }
+   return s;
+}
