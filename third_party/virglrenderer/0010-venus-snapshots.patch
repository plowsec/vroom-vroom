+vkr_snap_create(void);
+
+void
+vkr_snap_destroy(struct vkr_snap *snap);
+
+/* teardown: stop following */
+void
+vkr_snap_off(struct vkr_snap *snap);
+
+void
+vkr_snap_note_ref(vkr_object_id id, VkObjectType type);
+
