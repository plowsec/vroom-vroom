+/* vroom: snapshots.  A worker that doesn't answer in this long is stuck in
+ * its driver: the context is dropped (its app sees the device lost), the
+ * snapshot goes on without it. */
+#define PROXY_CONTEXT_SNAPSHOT_TIMEOUT_MS 120000
+
+static bool
+proxy_context_wait_reply(struct proxy_context *ctx)
+{
+   struct pollfd p = { .fd = ctx->socket.fd, .events = POLLIN };
+   int r;
+   do {
+      r = poll(&p, 1, PROXY_CONTEXT_SNAPSHOT_TIMEOUT_MS);
+   } while (r < 0 && errno == EINTR);
+   if (r > 0)
+      return true;
+   proxy_log("ctx %d: the worker didn't answer: dropping it", ctx->base.ctx_id);
+   shutdown(ctx->socket.fd, SHUT_RDWR);
+   ctx->worker_gone = true;
+   return false;
+}
+
+int
+proxy_context_save(struct virgl_context *base, int *out_fd, uint64_t *out_size)
+{
+   struct proxy_context *ctx = (struct proxy_context *)base;
+   *out_fd = -1;
+   *out_size = 0;
+   if (ctx->worker_gone)
+      return -1;
+
+   const struct render_context_op_save_request req = {
+      .header.op = RENDER_CONTEXT_OP_SAVE,
+   };
+   if (!proxy_socket_send_request(&ctx->socket, &req, sizeof(req)) ||
+       !proxy_context_wait_reply(ctx))
+      return -1;
+
+   struct render_context_op_save_reply reply;
+   int fd = -1;
+   int fd_count = 0;
+   if (!proxy_socket_receive_reply_with_fds(&ctx->socket, &reply, sizeof(reply), &fd, 1,
+                                            &fd_count))
+      return -1;
+   if (reply.status < 0 || fd_count != 1) {
+      if (fd_count)
+         close(fd);
+      return -1;
+   }
+   struct stat st;
+   if (fstat(fd, &st) || (uint64_t)st.st_size < reply.size) {
+      close(fd);
+      return -1;
+   }
+   *out_fd = fd;
+   *out_size = reply.size;
+   return reply.status;
 }
 
+int
+proxy_context_restore(struct virgl_context *base, int fd, uint64_t size)
+{
+   struct proxy_context *ctx = (struct proxy_context *)base;
+   const struct render_context_op_restore_request req = {
+      .header.op = RENDER_CONTEXT_OP_RESTORE,
+      .size = size,
+   };
+   struct render_context_op_restore_reply reply = { .ok = false };
+   if (!ctx->worker_gone &&
+       proxy_socket_send_request_with_fds(&ctx->socket, &req, sizeof(req), &fd, 1) &&
+       proxy_context_wait_reply(ctx))
+      proxy_socket_receive_reply(&ctx->socket, &reply, sizeof(reply));
+   return reply.ok ? 0 : -1;
+}
+
+int
+proxy_context_resume(struct virgl_context *base)
+{
+   struct proxy_context *ctx = (struct proxy_context *)base;
+   const struct render_context_op_resume_request req = {
+      .header.op = RENDER_CONTEXT_OP_RESUME,
+   };
+   struct render_context_op_restore_reply reply = { .ok = false };
+   if (!ctx->worker_gone && proxy_socket_send_request(&ctx->socket, &req, sizeof(req)) &&
+       proxy_context_wait_reply(ctx))
+      proxy_socket_receive_reply(&ctx->socket, &reply, sizeof(reply));
+   return reply.ok ? 0 : -1;
+}
