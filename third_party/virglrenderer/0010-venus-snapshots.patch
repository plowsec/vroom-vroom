+
+void
+vkr_snap_note_remove(struct vkr_snap *snap, vkr_object_id id);
+
+/* descriptor writes of the command being dispatched (a later write of
+ * the same descriptors makes an older command unneeded), and copies */
+void
+vkr_snap_note_write(vkr_object_id set, uint32_t binding, uint32_t first, uint32_t count);
+
+void
+vkr_snap_note_copy(void);
+
+/* shm resources the context made (blob id 0) */
+void
+vkr_snap_note_shm(struct vkr_snap *snap, uint32_t res_id, bool add);
+
+/* something used that a snapshot can't bring back: the context comes back
