+   *copy = malloc(sizeof(**copy) * ((size_t)count + 1));
+   if (!*copy)
+      return 0;
+   memcpy(*copy, ranges, sizeof(**copy) * count);
+   VkShaderStageFlags stages;
+   if (vertex >= 0) {
+      (*copy)[vertex].size = end - (*copy)[vertex].offset;
