+
+static void
+inst(struct out *o, uint16_t op, int n, ...)
+{
+   va_list ap;
+   put(o, ((uint32_t)(n + 1) << 16) | op);
+   va_start(ap, n);
+   for (int i = 0; i < n; i++)
+      put(o, va_arg(ap, uint32_t));
+   va_end(ap);
+}
