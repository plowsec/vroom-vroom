+/* vroom: transform feedback, written by the vertex shaders themselves
+ * (vkr_xfb.h). Before each draw with such a pipeline bound we push where
+ * its vertices go, or that nothing goes anywhere: a draw never runs with
+ * push constants the guest set in our range. */
+
+static bool
+vkr_xfb_push(struct vkr_command_buffer *cmd, const struct vkr_xfb_push *push)
+{
+   const struct vkr_pipeline_layout *layout =
+      cmd->xfb.ctx ? vkr_context_get_object(cmd->xfb.ctx, cmd->xfb.pipeline.layout) : NULL;
+   if (!layout || layout->base.type != VK_OBJECT_TYPE_PIPELINE_LAYOUT || !layout->xfb_stages)
+      return false;
+   cmd->device->proc_table.CmdPushConstants(
+      cmd->base.handle.command_buffer, layout->base.handle.pipeline_layout,
+      cmd->xfb.pipeline.stages, VKR_XFB_PC_OFFSET, VKR_XFB_PC_SIZE, push);
+   return true;
+}
+
+/* Before a draw that captures nothing. False: skip the draw (its layout
+ * is gone). */
+static bool
+vkr_xfb_no_capture(struct vkr_command_buffer *cmd)
+{
+   static const struct vkr_xfb_push zero;
+   return !cmd->xfb.pipeline.captures || vkr_xfb_push(cmd, &zero);
+}
+
+/* vertices per primitive of the list topologies, 0 for the others */
+static uint32_t
+vkr_xfb_list_vertices(VkPrimitiveTopology topology)
+{
+   switch (topology) {
+   case VK_PRIMITIVE_TOPOLOGY_POINT_LIST:
+      return 1;
+   case VK_PRIMITIVE_TOPOLOGY_LINE_LIST:
+      return 2;
+   case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST:
+      return 3;
+   default:
+      return 0;
+   }
+}
+
+/* Before a non-indexed draw: where its vertices go. *captured: how many
+ * vertices it writes. False: skip the draw. */
+static bool
+vkr_xfb_before_draw(struct vkr_command_buffer *cmd,
+                    uint32_t vertex_count,
+                    uint32_t instance_count,
+                    uint32_t first_vertex,
+                    uint32_t first_instance,
+                    uint64_t *captured)
+{
+   struct vkr_command_buffer_xfb *x = &cmd->xfb;
+   const struct vkr_xfb_info *info = &x->pipeline.info;
+   struct vkr_xfb_push push = { 0 };
+
+   *captured = 0;
+   x->draw_counts[0] = x->draw_counts[1] = 0;
+   if (!x->pipeline.captures)
+      return true;
+
+   const uint32_t per = vkr_xfb_list_vertices(x->pipeline.dynamic_topology ? x->topology
+                                                                            : x->pipeline.topology);
+   if (x->active && per && (x->bound & info->buffers) == info->buffers) {
+      /* whole primitives, as many as fit in every buffer */
+      const uint32_t vc = vertex_count - vertex_count % per;
+      uint64_t n = (uint64_t)vc * instance_count;
+      for (uint32_t b = 0; b < VKR_XFB_MAX_BUFFERS; b++) {
+         if (!(info->buffers & (1u << b)))
+            continue;
+         const uint64_t room =
+            x->written[b] < x->size[b] ? (x->size[b] - x->written[b]) / info->strides[b] : 0;
+         if (room < n)
+            n = room;
+      }
+      if (n > UINT32_MAX)
+         n = UINT32_MAX;
+      n -= n % per;
+      x->draw_counts[0] = n / per;
+      x->draw_counts[1] = (uint64_t)vc * instance_count / per;
+      push.max_vertices = (uint32_t)n;
+      push.first_vertex = first_vertex;
+      push.first_instance = first_instance;
+      push.vertex_count = vc;
+      for (uint32_t b = 0; b < VKR_XFB_MAX_BUFFERS; b++) {
+         if (info->buffers & (1u << b))
+            push.addr[b] = x->addr[b] + x->written[b];
+      }
+      *captured = n;
+   }
+   return vkr_xfb_push(cmd, &push);
+}
+
 static void
+vkr_xfb_after_draw(struct vkr_command_buffer *cmd, uint64_t captured)
+{
+   struct vkr_command_buffer_xfb *x = &cmd->xfb;
+   for (uint32_t b = 0; b < VKR_XFB_MAX_BUFFERS; b++) {
+      if (x->pipeline.info.buffers & (1u << b))
+         x->written[b] += captured * x->pipeline.info.strides[b];
+   }
+   x->counts[VKR_COUNT_XFB_WRITTEN] += x->draw_counts[0];
+   x->counts[VKR_COUNT_XFB_NEEDED] += x->draw_counts[1];
+   x->draw_counts[0] = x->draw_counts[1] = 0;
+}
+
+/* A direct draw of `vertices` vertices, `instances` times: what pipeline
+ * statistics count. */
+static void
+vkr_xfb_count_draw(struct vkr_command_buffer *cmd, uint32_t vertices, uint32_t instances)
+{
+   struct vkr_command_buffer_xfb *x = &cmd->xfb;
+   const uint64_t n = vertices;
+   uint64_t prims;
+   switch (x->pipeline.dynamic_topology ? x->topology : x->pipeline.topology) {
+   case VK_PRIMITIVE_TOPOLOGY_POINT_LIST:
+      prims = n;
+      break;
+   case VK_PRIMITIVE_TOPOLOGY_LINE_LIST:
+      prims = n / 2;
+      break;
+   case VK_PRIMITIVE_TOPOLOGY_LINE_STRIP:
+      prims = n > 1 ? n - 1 : 0;
+      break;
+   case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST:
+      prims = n / 3;
+      break;
+   case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP:
+   case VK_PRIMITIVE_TOPOLOGY_TRIANGLE_FAN:
+      prims = n > 2 ? n - 2 : 0;
+      break;
+   default:
+      prims = 0;
+      break;
+   }
+   x->counts[VKR_COUNT_PRIMITIVES] += prims * instances;
+   x->counts[VKR_COUNT_VERTICES] += n * instances;
+}
+
+/* A query of a fake pool begins or ends. */
+static void
+vkr_xfb_query(struct vkr_context *ctx,
+              struct vkr_command_buffer *cmd,
+              VkQueryPool handle,
+              uint32_t query,
+              bool begin)
+{
+   struct vkr_command_buffer_xfb *x = &cmd->xfb;
+   const struct vkr_query_pool *begun = vkr_query_pool_from_handle(handle);
+   const uint32_t n = ARRAY_SIZE(x->queries);
+   if (!begun)
+      return;
+   if (begin) {
+      for (uint32_t i = 0; i < n; i++) {
+         if (!x->queries[i].pool) {
+            x->queries[i].pool = begun->base.id;
+            x->queries[i].query = query;
+            memcpy(x->queries[i].start, x->counts, sizeof(x->counts));
+            return;
+         }
+      }
+      return;
+   }
+   for (uint32_t i = 0; i < n; i++) {
+      if (x->queries[i].pool == begun->base.id && x->queries[i].query == query) {
+         struct vkr_query_pool *pool = vkr_context_get_object(ctx, x->queries[i].pool);
+         if (pool && pool->base.type == VK_OBJECT_TYPE_QUERY_POOL && pool->fake_xfb) {
+            uint64_t counted[VKR_COUNT_MAX];
+            for (int k = 0; k < VKR_COUNT_MAX; k++)
+               counted[k] = x->counts[k] - x->queries[i].start[k];
+            vkr_query_pool_fake_end(pool, query, counted);
+         }
+         x->queries[i].pool = 0;
+         return;
+      }
+   }
+}
+
+/* The bytes a counter buffer said, as recorded; NULL if unknown (and
+ * `add` is false). */
+static VkDeviceSize *
+vkr_xfb_counter(struct vkr_device *dev, VkBuffer buffer, VkDeviceSize offset, bool add)
+{
+   const uint32_t n = ARRAY_SIZE(dev->xfb_counters);
+   for (uint32_t i = 0; i < n; i++) {
+      if (dev->xfb_counters[i].buffer == buffer && dev->xfb_counters[i].offset == offset)
+         return &dev->xfb_counters[i].value;
+   }
+   if (!add)
+      return NULL;
+   const uint32_t i = dev->xfb_counter_next++ % n;
+   dev->xfb_counters[i].buffer = buffer;
+   dev->xfb_counters[i].offset = offset;
+   dev->xfb_counters[i].value = 0;
+   return &dev->xfb_counters[i].value;
+}
+
+static VkBuffer
+vkr_xfb_host_buffer(VkBuffer guest)
+{
+   const struct vkr_buffer *buf = vkr_buffer_from_handle(guest);
+   return buf ? buf->base.handle.buffer : VK_NULL_HANDLE;
+}
