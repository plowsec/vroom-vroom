+   size_t types_at;            /* where types begin */
+   size_t functions_at;        /* first OpFunction */
+
+   uint32_t t_bool, t_uint, t_ulong;
+   uint32_t pc_var, pc_struct, pc_members; /* existing push constants, if any */
+   uint32_t vi_var, ii_var;
+   uint32_t vi_type, ii_type; /* their int type ids */
+
+   bool in_entry; /* while copying the entry point's function */
+
+   struct item items[MAX_ITEMS];
+   uint32_t nitems;
+   struct vkr_xfb_info info;
+};
+
+static uint32_t
+op_of(uint32_t w)
+{
+   return w & 0xffff;
+}
+
+static uint32_t
+len_of(uint32_t w)
+{
+   return w >> 16;
+}
+
+/* Words of a nul-terminated literal string at w[0..max). 0: malformed. */
+static uint32_t
+string_words(const uint32_t *w, uint32_t max)
+{
+   for (uint32_t i = 0; i < max; i++) {
+      uint32_t v = w[i];
+      if (!(v & 0xff) || !(v & 0xff00) || !(v & 0xff0000) || !(v & 0xff000000))
+         return i + 1;
+   }
+   return 0;
+}
+
+static bool
+in_bounds(const struct rewriter *r, uint32_t id)
+{
+   return id > 0 && id < r->bound;
+}
+
+/* First pass: what the module declares. */
+static bool
+scan(struct rewriter *r)
+{
+   const uint32_t *c = r->code;
+   bool in_preamble = true;
+   r->types_at = r->functions_at = 0;
+
+   for (size_t at = 5; at < r->words;) {
+      const uint32_t op = op_of(c[at]), len = len_of(c[at]);
+      if (!len || at + len > r->words)
+         return false;
+      const uint32_t *a = &c[at + 1]; /* operands */
+      const uint32_t n = len - 1;
+
+      if (in_preamble) {
+         switch (op) {
+         case OP_CAPABILITY: case OP_EXTENSION: case OP_EXT_INST_IMPORT: case OP_MEMORY_MODEL:
+         case OP_ENTRY_POINT: case OP_EXECUTION_MODE: case OP_EXECUTION_MODE_ID:
+         case OP_SOURCE_CONTINUED: case OP_SOURCE: case OP_SOURCE_EXTENSION: case OP_NAME:
+         case OP_MEMBER_NAME: case OP_STRING: case OP_MODULE_PROCESSED: case OP_DECORATE:
+         case OP_MEMBER_DECORATE: case OP_DECORATION_GROUP: case OP_GROUP_DECORATE:
+         case OP_GROUP_MEMBER_DECORATE: case OP_DECORATE_ID: case OP_DECORATE_STRING:
+         case OP_MEMBER_DECORATE_STRING:
+            break;
+         default:
+            in_preamble = false;
+            r->types_at = at;
+            break;
+         }
+      }
+
+      switch (op) {
+      case OP_CAPABILITY:
+         if (n < 1)
+            return false;
+         if (a[0] == CAP_INT64)
+            r->has_int64 = true;
+         if (a[0] == CAP_PHYSICAL_STORAGE_BUFFER_ADDRESSES)
+            r->has_psb = true;
+         r->last_capability_end = at + len;
+         break;
+      case OP_MEMORY_MODEL:
+         if (n != 2)
+            return false;
+         r->memory_model_at = at;
+         break;
+      case OP_ENTRY_POINT: {
+         if (n < 3)
+            return false;
+         const uint32_t sw = string_words(&a[2], n - 2);
+         if (!sw)
+            return false;
+         if (a[0] == EXEC_MODEL_VERTEX && !r->entry_id) {
+            r->entry_at = at;
+            r->entry_id = a[1];
+            r->iface_start = (uint32_t)(at + 3 + sw);
+            r->iface_end = (uint32_t)(at + len);
+         }
+         break;
+      }
+      case OP_EXECUTION_MODE:
+         if (n >= 2 && a[1] == EXEC_MODE_XFB && a[0] == r->entry_id && r->entry_id)
+            r->xfb = true;
+         break;
+      case OP_DECORATE_ID:
+      case OP_DECORATE_STRING:
+      case OP_MEMBER_DECORATE_STRING:
+      case OP_DECORATION_GROUP:
+      case OP_GROUP_DECORATE:
+      case OP_GROUP_MEMBER_DECORATE:
+         /* decoration groups could carry xfb decorations we'd miss */
+         break;
+      case OP_DECORATE:
+         if (n < 2 || !in_bounds(r, a[0]))
+            return false;
+         if (n >= 3) {
+            if (a[1] == DEC_XFB_BUFFER)
+               r->xfb_buffer[a[0]] = a[2];
+            else if (a[1] == DEC_XFB_STRIDE)
+               r->xfb_stride[a[0]] = a[2];
+            else if (a[1] == DEC_OFFSET)
+               r->offset[a[0]] = a[2];
+            else if (a[1] == DEC_BUILTIN)
+               r->builtin[a[0]] = a[2];
+         }
+         break;
+      case OP_MEMBER_DECORATE:
+         if (n < 3 || !in_bounds(r, a[0]))
+            return false;
+         if (a[2] == DEC_OFFSET && n >= 4 &&
+             (r->max_member_offset[a[0]] == NONE || a[3] > r->max_member_offset[a[0]]))
+            r->max_member_offset[a[0]] = a[3];
+         break;
+      case OP_TYPE_BOOL:
+         if (n != 1 || !in_bounds(r, a[0]))
+            return false;
+         r->types[a[0]] = (struct type){ op, 0, 0 };
+         if (!r->t_bool)
+            r->t_bool = a[0];
+         break;
+      case OP_TYPE_INT:
+         if (n != 3 || !in_bounds(r, a[0]))
+            return false;
+         r->types[a[0]] = (struct type){ op, a[1], a[2] };
+         if (a[1] == 32 && !a[2] && !r->t_uint)
+            r->t_uint = a[0];
+         if (a[1] == 64 && !a[2] && !r->t_ulong)
+            r->t_ulong = a[0];
+         break;
+      case OP_TYPE_FLOAT:
+         if (n < 2 || !in_bounds(r, a[0]))
+            return false;
+         r->types[a[0]] = (struct type){ op, a[1], 0 };
+         break;
+      case OP_TYPE_VECTOR:
+      case OP_TYPE_ARRAY:
+         if (n != 3 || !in_bounds(r, a[0]))
+            return false;
+         r->types[a[0]] = (struct type){ op, a[1], a[2] };
+         break;
+      case OP_TYPE_STRUCT:
+         if (n < 1 || !in_bounds(r, a[0]))
+            return false;
+         r->types[a[0]] = (struct type){ op, n - 1, (uint32_t)at };
+         break;
+      case OP_TYPE_POINTER:
+         if (n != 3 || !in_bounds(r, a[0]))
+            return false;
+         r->types[a[0]] = (struct type){ op, a[1], a[2] };
+         break;
+      case OP_CONSTANT:
+         if (n == 3 && in_bounds(r, a[1]))
+            r->const_val[a[1]] = a[2];
+         break;
+      case OP_VARIABLE: {
+         if (n < 3 || !in_bounds(r, a[0]) || !in_bounds(r, a[1]))
+            return false;
+         const struct type *pt = &r->types[a[0]];
+         if (pt->op != OP_TYPE_POINTER || !in_bounds(r, pt->b) || r->nvars >= r->bound)
+            return false;
+         r->vars[r->nvars++] = (struct var){ a[1], a[2], pt->b };
+         break;
+      }
+      case OP_FUNCTION:
+         if (!r->functions_at)
+            r->functions_at = at;
+         break;
+      default:
+         break;
+      }
+      at += len;
+   }
+   return r->entry_id && r->memory_model_at && r->types_at && r->functions_at &&
+          r->last_capability_end;
+}
+
+static const struct var *
+find_var(const struct rewriter *r, uint32_t id)
+{
+   for (uint32_t i = 0; i < r->nvars; i++) {
+      if (r->vars[i].id == id)
+         return &r->vars[i];
+   }
+   return NULL;
+}
+
+/* A 32-bit scalar type: float, int or uint. */
+static bool
+scalar32(const struct rewriter *r, uint32_t id, bool *is_uint)
+{
+   if (!in_bounds(r, id))
+      return false;
+   const struct type *t = &r->types[id];
+   if ((t->op == OP_TYPE_FLOAT || t->op == OP_TYPE_INT) && t->a == 32) {
+      *is_uint = t->op == OP_TYPE_INT && !t->b;
+      return true;
+   }
+   return false;
+}
+
+/* What the entry point captures, and the push constants and built-ins it
+ * already has. */
+static bool
+collect(struct rewriter *r)
+{
+   const uint32_t *c = r->code;
+   uint32_t ncomp = 0;
+
+   r->vi_var = r->ii_var = r->pc_var = 0;
+   for (uint32_t w = r->iface_start; w < r->iface_end; w++) {
+      const uint32_t id = c[w];
+      const struct var *v = find_var(r, id);
+      if (!v)
+         return false;
+
+      if (v->storage == SC_PUSH_CONSTANT) {
+         if (r->pc_var)
+            return false;
+         r->pc_var = id;
+      }
+      if (v->storage == SC_INPUT && r->builtin[id] == BUILTIN_VERTEX_INDEX)
+         r->vi_var = id;
+      if (v->storage == SC_INPUT && r->builtin[id] == BUILTIN_INSTANCE_INDEX)
+         r->ii_var = id;
+      if (v->storage != SC_OUTPUT || r->offset[id] == NONE)
+         continue;
+
+      /* a captured output */
+      if (r->nitems == MAX_ITEMS || !in_bounds(r, v->type))
+         return false;
+      struct item *it = &r->items[r->nitems++];
+      it->var = id;
+      it->type = v->type;
+      it->buffer = r->xfb_buffer[id];
+      it->offset = r->offset[id];
+      const uint32_t stride = r->xfb_stride[id];
+      if (it->buffer >= VKR_XFB_MAX_BUFFERS || stride == NONE || !stride || stride % 4 ||
+          stride > 2048 || it->offset % 4)
+         return false;
+      if (r->info.strides[it->buffer] && r->info.strides[it->buffer] != stride)
+         return false;
+      r->info.strides[it->buffer] = stride;
+      r->info.buffers |= 1u << it->buffer;
+
+      const struct type *t = &r->types[v->type];
+      it->elems = 0;
+      it->elem = v->type;
+      if (t->op == OP_TYPE_ARRAY) {
+         if (!in_bounds(r, t->b) || r->const_val[t->b] == NONE)
+            return false;
+         it->elems = r->const_val[t->b];
+         if (!it->elems || it->elems > MAX_ARRAY)
+            return false;
+         it->elem = t->a;
+      }
+      if (!in_bounds(r, it->elem))
+         return false;
+      const struct type *e = &r->types[it->elem];
+      if (e->op == OP_TYPE_VECTOR) {
+         it->comps = e->b;
+         it->scalar = e->a;
+         if (it->comps < 2 || it->comps > 4)
+            return false;
+      } else {
+         it->comps = 1;
+         it->scalar = it->elem;
+      }
+      if (!scalar32(r, it->scalar, &it->scalar_uint))
+         return false;
+
+      const uint32_t total = (it->elems ? it->elems : 1) * it->comps;
+      ncomp += total;
+      if (ncomp > MAX_COMPONENTS || (uint64_t)it->offset + 4ull * total > stride)
+         return false;
+   }
+   if (!r->nitems)
+      return false;
+
+   if (r->pc_var) {
+      const struct var *v = find_var(r, r->pc_var);
+      const struct type *t = &r->types[v->type];
+      if (t->op != OP_TYPE_STRUCT)
+         return false;
+      r->pc_struct = v->type;
+      r->pc_members = t->a;
+      /* ours must sit above what it has */
+      if (r->max_member_offset[v->type] != NONE &&
+          (uint64_t)r->max_member_offset[v->type] + 16 > VKR_XFB_PC_OFFSET)
+         return false;
+   }
+
+   /* built-ins: 32-bit ints, signed or not */
+   for (int k = 0; k < 2; k++) {
+      const uint32_t var = k ? r->ii_var : r->vi_var;
+      if (!var)
+         continue;
+      const struct var *v = find_var(r, var);
+      bool is_uint;
+      if (!scalar32(r, v->type, &is_uint) || r->types[v->type].op != OP_TYPE_INT)
+         return false;
+      if (k)
+         r->ii_type = v->type;
+      else
+         r->vi_type = v->type;
+   }
+   return true;
+}
+
+/* The capture code, emitted in place of an OpReturn. */
+struct ids {
+   uint32_t uint, ulong, bool_, ptr_pc_uint, ptr_pc_ulong, ptr_psb_uint;
+   uint32_t pc, vi, ii;
+   uint32_t member[8];   /* uint constants: our members' indices */
+   uint32_t stride[VKR_XFB_MAX_BUFFERS]; /* ulong constants */
+   uint32_t offsets[MAX_COMPONENTS];     /* ulong constants, one per component */
+};
+
+static uint32_t
+new_id(struct rewriter *r)
+{
+   return r->bound++;
+}
+
+static void
+emit_capture(struct rewriter *r, struct out *o, const struct ids *ids)
+{
+   uint32_t idx_v[2];
+   for (int k = 0; k < 2; k++) {
+      const uint32_t var = k ? ids->ii : ids->vi;
+      const uint32_t type = k ? (r->ii_var ? r->ii_type : ids->uint) : (r->vi_var ? r->vi_type : ids->uint);
+      const uint32_t v = new_id(r);
+      inst(o, OP_LOAD, 3, type, v, var);
+      if (type != ids->uint) {
+         idx_v[k] = new_id(r);
+         inst(o, OP_BITCAST, 3, ids->uint, idx_v[k], v);
+      } else {
+         idx_v[k] = v;
+      }
+   }
+   uint32_t pcv[4]; /* max_vertices, first_vertex, first_instance, vertex_count */
+   for (int k = 0; k < 4; k++) {
+      const uint32_t p = new_id(r);
+      inst(o, OP_ACCESS_CHAIN, 4, ids->ptr_pc_uint, p, ids->pc, ids->member[4 + k]);
+      pcv[k] = new_id(r);
+      inst(o, OP_LOAD, 3, ids->uint, pcv[k], p);
+   }
+   const uint32_t v = new_id(r), i = new_id(r), t = new_id(r), idx = new_id(r);
+   inst(o, OP_ISUB, 4, ids->uint, v, idx_v[0], pcv[1]);
+   inst(o, OP_ISUB, 4, ids->uint, i, idx_v[1], pcv[2]);
+   inst(o, OP_IMUL, 4, ids->uint, t, i, pcv[3]);
+   inst(o, OP_IADD, 4, ids->uint, idx, t, v);
+   const uint32_t ok1 = new_id(r), ok2 = new_id(r), ok = new_id(r);
+   inst(o, OP_ULESS_THAN, 4, ids->bool_, ok1, v, pcv[3]);
+   inst(o, OP_ULESS_THAN, 4, ids->bool_, ok2, idx, pcv[0]);
+   inst(o, OP_LOGICAL_AND, 4, ids->bool_, ok, ok1, ok2);
+   const uint32_t body = new_id(r), merge = new_id(r);
+   inst(o, OP_SELECTION_MERGE, 2, merge, 0);
+   inst(o, OP_BRANCH_CONDITIONAL, 3, ok, body, merge);
+   inst(o, OP_LABEL, 1, body);
+
+   const uint32_t idx64 = new_id(r);
+   inst(o, OP_UCONVERT, 3, ids->ulong, idx64, idx);
+   uint32_t base[VKR_XFB_MAX_BUFFERS] = { 0 };
+   for (uint32_t b = 0; b < VKR_XFB_MAX_BUFFERS; b++) {
+      if (!(r->info.buffers & (1u << b)))
+         continue;
+      const uint32_t p = new_id(r), a = new_id(r), m = new_id(r);
+      inst(o, OP_ACCESS_CHAIN, 4, ids->ptr_pc_ulong, p, ids->pc, ids->member[b]);
+      inst(o, OP_LOAD, 3, ids->ulong, a, p);
+      inst(o, OP_IMUL, 4, ids->ulong, m, idx64, ids->stride[b]);
+      base[b] = new_id(r);
+      inst(o, OP_IADD, 4, ids->ulong, base[b], a, m);
+   }
+
+   uint32_t comp = 0;
+   for (uint32_t n = 0; n < r->nitems; n++) {
+      const struct item *it = &r->items[n];
+      const uint32_t val = new_id(r);
+      inst(o, OP_LOAD, 3, it->type, val, it->var);
+      const uint32_t elems = it->elems ? it->elems : 1;
+      for (uint32_t e = 0; e < elems; e++) {
+         uint32_t ev = val;
+         if (it->elems) {
+            ev = new_id(r);
+            inst(o, OP_COMPOSITE_EXTRACT, 4, it->elem, ev, val, e);
+         }
+         for (uint32_t k = 0; k < it->comps; k++, comp++) {
+            uint32_t s = ev;
+            if (it->comps > 1) {
+               s = new_id(r);
+               inst(o, OP_COMPOSITE_EXTRACT, 4, it->scalar, s, ev, k);
+            }
+            if (!it->scalar_uint) {
+               const uint32_t u = new_id(r);
+               inst(o, OP_BITCAST, 3, ids->uint, u, s);
+               s = u;
+            }
+            const uint32_t ad = new_id(r), ptr = new_id(r);
+            inst(o, OP_IADD, 4, ids->ulong, ad, base[it->buffer], ids->offsets[comp]);
+            inst(o, OP_CONVERT_U_TO_PTR, 3, ids->ptr_psb_uint, ptr, ad);
+            inst(o, OP_STORE, 4, ptr, s, MEMORY_ACCESS_ALIGNED, 4);
+         }
+      }
+   }
+   inst(o, OP_BRANCH, 1, merge);
+   inst(o, OP_LABEL, 1, merge);
+   inst(o, OP_RETURN, 0);
+}
+
+static uint32_t *
+rewrite(struct rewriter *r, size_t *out_words)
+{
+   const uint32_t *c = r->code;
+   struct out o = { 0 };
+   struct ids ids = { 0 };
+
+   /* ids of what we add */
+   const bool new_uint = !r->t_uint, new_ulong = !r->t_ulong, new_bool = !r->t_bool;
+   ids.uint = new_uint ? new_id(r) : r->t_uint;
+   ids.ulong = new_ulong ? new_id(r) : r->t_ulong;
+   ids.bool_ = new_bool ? new_id(r) : r->t_bool;
+   ids.ptr_pc_uint = new_id(r);
+   ids.ptr_pc_ulong = new_id(r);
+   ids.ptr_psb_uint = new_id(r);
+   const bool new_pc = !r->pc_var;
+   const uint32_t pc_struct = new_pc ? new_id(r) : r->pc_struct;
+   const uint32_t pc_ptr = new_pc ? new_id(r) : 0;
+   ids.pc = new_pc ? new_id(r) : r->pc_var;
+   const uint32_t first_member = new_pc ? 0 : r->pc_members;
+   const uint32_t ptr_in_uint = (!r->vi_var || !r->ii_var) ? new_id(r) : 0;
+   ids.vi = r->vi_var ? r->vi_var : new_id(r);
+   ids.ii = r->ii_var ? r->ii_var : new_id(r);
+   for (int k = 0; k < 8; k++)
+      ids.member[k] = new_id(r);
+   for (uint32_t b = 0; b < VKR_XFB_MAX_BUFFERS; b++)
+      ids.stride[b] = new_id(r);
+   uint32_t ncomp = 0;
+   for (uint32_t n = 0; n < r->nitems; n++) {
+      const struct item *it = &r->items[n];
+      const uint32_t elems = it->elems ? it->elems : 1;
+      for (uint32_t e = 0; e < elems; e++) {
+         for (uint32_t k = 0; k < it->comps; k++)
+            ids.offsets[ncomp++] = new_id(r);
+      }
+   }
+
+   for (size_t at = 0; at < r->words && !o.oom;) {
+      if (at < 5) {
+         put_words(&o, c, 5); /* the bound is fixed at the end */
+         at = 5;
+         continue;
+      }
+      const uint32_t op = op_of(c[at]), len = len_of(c[at]);
+
+      if (at == r->last_capability_end) {
+         if (!r->has_psb)
+            inst(&o, OP_CAPABILITY, 1, CAP_PHYSICAL_STORAGE_BUFFER_ADDRESSES);
+         if (!r->has_int64)
+            inst(&o, OP_CAPABILITY, 1, CAP_INT64);
+      }
+
+      if (at == r->types_at) {
+         /* decorations, then the scalar types everything else uses */
+         for (int k = 0; k < 8; k++) {
+            const uint32_t off = VKR_XFB_PC_OFFSET + (k < 4 ? 8 * k : 32 + 4 * (k - 4));
+            inst(&o, OP_MEMBER_DECORATE, 4, pc_struct, first_member + k, DEC_OFFSET, off);
+         }
+         if (new_pc)
+            inst(&o, OP_DECORATE, 2, pc_struct, DEC_BLOCK);
+         if (!r->vi_var)
+            inst(&o, OP_DECORATE, 3, ids.vi, DEC_BUILTIN, BUILTIN_VERTEX_INDEX);
+         if (!r->ii_var)
+            inst(&o, OP_DECORATE, 3, ids.ii, DEC_BUILTIN, BUILTIN_INSTANCE_INDEX);
+         if (new_uint)
+            inst(&o, OP_TYPE_INT, 3, ids.uint, 32, 0);
+         if (new_ulong)
+            inst(&o, OP_TYPE_INT, 3, ids.ulong, 64, 0);
+         if (new_bool)
+            inst(&o, OP_TYPE_BOOL, 1, ids.bool_);
+      }
+
+      if (at == r->functions_at) {
+         inst(&o, OP_TYPE_POINTER, 3, ids.ptr_pc_uint, SC_PUSH_CONSTANT, ids.uint);
+         inst(&o, OP_TYPE_POINTER, 3, ids.ptr_pc_ulong, SC_PUSH_CONSTANT, ids.ulong);
+         inst(&o, OP_TYPE_POINTER, 3, ids.ptr_psb_uint, SC_PHYSICAL_STORAGE_BUFFER, ids.uint);
+         if (new_pc) {
+            inst(&o, OP_TYPE_STRUCT, 9, pc_struct, ids.ulong, ids.ulong, ids.ulong, ids.ulong,
+                 ids.uint, ids.uint, ids.uint, ids.uint);
+            inst(&o, OP_TYPE_POINTER, 3, pc_ptr, SC_PUSH_CONSTANT, pc_struct);
+            inst(&o, OP_VARIABLE, 3, pc_ptr, ids.pc, SC_PUSH_CONSTANT);
+         }
+         if (ptr_in_uint) {
+            inst(&o, OP_TYPE_POINTER, 3, ptr_in_uint, SC_INPUT, ids.uint);
+            if (!r->vi_var)
+               inst(&o, OP_VARIABLE, 3, ptr_in_uint, ids.vi, SC_INPUT);
+            if (!r->ii_var)
+               inst(&o, OP_VARIABLE, 3, ptr_in_uint, ids.ii, SC_INPUT);
+         }
+         for (int k = 0; k < 8; k++)
+            inst(&o, OP_CONSTANT, 3, ids.uint, ids.member[k], first_member + k);
+         for (uint32_t b = 0; b < VKR_XFB_MAX_BUFFERS; b++)
+            inst(&o, OP_CONSTANT, 4, ids.ulong, ids.stride[b], r->info.strides[b], 0);
+         uint32_t comp = 0;
+         for (uint32_t n = 0; n < r->nitems; n++) {
+            const struct item *it = &r->items[n];
+            const uint32_t elems = it->elems ? it->elems : 1;
+            for (uint32_t e = 0; e < elems; e++) {
+               for (uint32_t k = 0; k < it->comps; k++, comp++)
+                  inst(&o, OP_CONSTANT, 4, ids.ulong, ids.offsets[comp],
+                       it->offset + 4 * (e * it->comps + k), 0);
+            }
+         }
+      }
+
+      if (at == r->memory_model_at) {
+         inst(&o, OP_MEMORY_MODEL, 2, ADDRESSING_PHYSICAL_STORAGE_BUFFER64, c[at + 2]);
+      } else if (at == r->entry_at) {
+         uint32_t extra[3], nextra = 0;
+         if (new_pc)
+            extra[nextra++] = ids.pc;
+         if (!r->vi_var)
+            extra[nextra++] = ids.vi;
+         if (!r->ii_var)
+            extra[nextra++] = ids.ii;
+         put(&o, ((len + nextra) << 16) | op);
+         put_words(&o, &c[at + 1], len - 1);
+         put_words(&o, extra, nextra);
+      } else if (op == OP_TYPE_STRUCT && !new_pc && c[at + 1] == pc_struct) {
+         put(&o, ((len + 8) << 16) | op);
+         put_words(&o, &c[at + 1], len - 1);
+         for (int k = 0; k < 8; k++)
+            put(&o, k < 4 ? ids.ulong : ids.uint);
+      } else if (op == OP_RETURN && r->in_entry) {
+         emit_capture(r, &o, &ids);
+      } else {
+         put_words(&o, &c[at], len);
+      }
+
+      if (op == OP_FUNCTION)
+         r->in_entry = c[at + 2] == r->entry_id;
+      else if (op == OP_FUNCTION_END)
+         r->in_entry = false;
+      at += len;
+   }
+
+   if (o.oom) {
+      free(o.w);
+      return NULL;
+   }
+   o.w[3] = r->bound;
+   *out_words = o.n;
+   return o.w;
+}
+
+uint32_t *
+vkr_xfb_rewrite(const uint32_t *code,
+                size_t words,
+                size_t *out_words,
+                struct vkr_xfb_info *info)
+{
+   memset(info, 0, sizeof(*info));
+   if (words < 5 || code[0] != 0x07230203)
+      return NULL;
+   /* PhysicalStorageBuffer without an extension: SPIR-V 1.5 and later */
+   const uint32_t version = code[1];
+   if (version < 0x00010500 || version > 0x00010600)
+      return NULL;
+   const uint32_t bound = code[3];
+   if (!bound || bound > (1u << 22))
+      return NULL;
+
+   struct rewriter r = { .code = code, .words = words, .bound = bound, .version = version };
+   r.types = calloc(bound, sizeof(*r.types));
+   r.const_val = malloc(bound * sizeof(uint32_t));
+   r.xfb_buffer = malloc(bound * sizeof(uint32_t));
+   r.xfb_stride = malloc(bound * sizeof(uint32_t));
+   r.offset = malloc(bound * sizeof(uint32_t));
+   r.builtin = malloc(bound * sizeof(uint32_t));
+   r.max_member_offset = malloc(bound * sizeof(uint32_t));
+   r.vars = malloc(bound * sizeof(*r.vars));
+   uint32_t *result = NULL;
+   if (!r.types || !r.const_val || !r.xfb_buffer || !r.xfb_stride || !r.offset ||
+       !r.builtin || !r.max_member_offset || !r.vars)
+      goto out;
+   memset(r.const_val, 0xff, bound * sizeof(uint32_t));
+   memset(r.xfb_buffer, 0xff, bound * sizeof(uint32_t));
+   memset(r.xfb_stride, 0xff, bound * sizeof(uint32_t));
+   memset(r.offset, 0xff, bound * sizeof(uint32_t));
+   memset(r.builtin, 0xff, bound * sizeof(uint32_t));
+   memset(r.max_member_offset, 0xff, bound * sizeof(uint32_t));
+
+   if (!scan(&r) || !r.xfb || !collect(&r))
+      goto out;
+   /* room for our ids */
+   if (r.bound > (1u << 22) - 4 * MAX_COMPONENTS - 64)
+      goto out;
+   result = rewrite(&r, out_words);
+   if (result)
+      *info = r.info;
+
+out:
+   free(r.types);
+   free(r.const_val);
+   free(r.xfb_buffer);
+   free(r.xfb_stride);
+   free(r.offset);
+   free(r.builtin);
+   free(r.max_member_offset);
+   free(r.vars);
+   if (!result)
+      memset(info, 0, sizeof(*info));
+   return result;
+}
diff --git a/src/venus/vkr_xfb.h b/src/venus/vkr_xfb.h
--- a/src/venus/vkr_xfb.h
+++ b/src/venus/vkr_xfb.h
@@ -0,0 +1,55 @@
+/*
