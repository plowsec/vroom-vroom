+ */
+
+#ifndef VKR_XFB_H
+#define VKR_XFB_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* Transform feedback for zink on a host without it (MoltenVK).
+ *
+ * A vertex shader with the Xfb execution mode gets, before each return,
+ * code that stores its captured outputs through buffer device addresses
+ * the host pushes as push constants at VKR_XFB_PC_OFFSET:
+ *
+ *    uint64_t addr[4];      buffer i's address for this draw (with what
+ *                           was written before)
+ *    uint32_t max_vertices; vertices that fit in every buffer used; 0: none
+ *    uint32_t first_vertex, first_instance, vertex_count;
+ *
+ * Vertex n of instance i (n < vertex_count) goes to slot
+ * i * vertex_count + n, if that is below max_vertices. Only non-indexed
+ * draws of point, line and triangle lists capture: there the slots are the
+ * order transform feedback writes in.
+ */
+#define VKR_XFB_PC_OFFSET 256
+#define VKR_XFB_PC_SIZE 48
+#define VKR_XFB_MAX_BUFFERS 4
+
+struct vkr_xfb_push {
+   uint64_t addr[VKR_XFB_MAX_BUFFERS];
+   uint32_t max_vertices;
+   uint32_t first_vertex;
+   uint32_t first_instance;
+   uint32_t vertex_count;
+};
+
+struct vkr_xfb_info {
+   uint32_t strides[VKR_XFB_MAX_BUFFERS]; /* bytes per vertex */
+   uint32_t buffers;                      /* mask of the buffers written */
+};
+
+/* The vertex shader in code[0..words) with capture code added, malloc'ed
+ * (its length in *out_words), or NULL: not a vertex shader with Xfb, or
+ * one we can't rewrite. */
+uint32_t *
+vkr_xfb_rewrite(const uint32_t *code,
+                size_t words,
+                size_t *out_words,
+                struct vkr_xfb_info *info);
+
+#endif /* VKR_XFB_H */
