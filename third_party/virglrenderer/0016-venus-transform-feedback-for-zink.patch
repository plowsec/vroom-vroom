+
+/* Rewrites a vertex shader so it writes its transform feedback outputs
+ * itself (see vkr_xfb.h). The SPIR-V comes from the guest: every read is
+ * checked against the module's size, and anything unusual makes us give
+ * up, which leaves the module as it was (nothing captured). The host's
+ * own compiler (MoltenVK's) still reads the result as it read the guest's
+ * module before. */
+
+#include "vkr_xfb.h"
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+enum {
+   OP_SOURCE_CONTINUED = 2,
+   OP_SOURCE = 3,
+   OP_SOURCE_EXTENSION = 4,
+   OP_NAME = 5,
+   OP_MEMBER_NAME = 6,
+   OP_STRING = 7,
+   OP_LINE = 8,
+   OP_EXTENSION = 10,
+   OP_EXT_INST_IMPORT = 11,
+   OP_MEMORY_MODEL = 14,
+   OP_ENTRY_POINT = 15,
+   OP_EXECUTION_MODE = 16,
+   OP_CAPABILITY = 17,
+   OP_TYPE_BOOL = 20,
+   OP_TYPE_INT = 21,
+   OP_TYPE_FLOAT = 22,
+   OP_TYPE_VECTOR = 23,
+   OP_TYPE_ARRAY = 28,
+   OP_TYPE_STRUCT = 30,
+   OP_TYPE_POINTER = 32,
+   OP_CONSTANT = 43,
+   OP_FUNCTION = 54,
+   OP_FUNCTION_END = 56,
+   OP_VARIABLE = 59,
+   OP_LOAD = 61,
+   OP_STORE = 62,
+   OP_ACCESS_CHAIN = 65,
+   OP_DECORATE = 71,
+   OP_MEMBER_DECORATE = 72,
+   OP_DECORATION_GROUP = 73,
+   OP_GROUP_DECORATE = 74,
+   OP_GROUP_MEMBER_DECORATE = 75,
+   OP_COMPOSITE_EXTRACT = 81,
+   OP_UCONVERT = 113,
+   OP_CONVERT_U_TO_PTR = 120,
+   OP_BITCAST = 124,
+   OP_IADD = 128,
+   OP_ISUB = 130,
+   OP_IMUL = 132,
+   OP_LOGICAL_AND = 167,
+   OP_ULESS_THAN = 176,
+   OP_SELECTION_MERGE = 247,
+   OP_LABEL = 248,
+   OP_BRANCH = 249,
+   OP_BRANCH_CONDITIONAL = 250,
+   OP_RETURN = 253,
+   OP_NO_LINE = 317,
+   OP_MODULE_PROCESSED = 330,
+   OP_EXECUTION_MODE_ID = 331,
+   OP_DECORATE_ID = 332,
+   OP_DECORATE_STRING = 5632,
+   OP_MEMBER_DECORATE_STRING = 5633,
