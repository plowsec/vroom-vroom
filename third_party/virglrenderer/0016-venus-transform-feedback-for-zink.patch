+   uint32_t *const_val; /* by id: 32-bit integer constants, NONE otherwise */
+   uint32_t *xfb_buffer, *xfb_stride, *offset, *builtin; /* decorations by id, NONE when absent */
+   uint32_t *max_member_offset; /* by struct id */
+
+   struct var *vars;
