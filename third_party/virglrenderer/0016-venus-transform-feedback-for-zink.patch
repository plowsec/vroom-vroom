+   for (uint32_t i = 0; i < count; i++) {
+      if ((uint64_t)ranges[i].offset + ranges[i].size > start)
+         return 0;
+      if (ranges[i].stageFlags & VK_SHADER_STAGE_VERTEX_BIT)
+         vertex = (int)i;
+   }
