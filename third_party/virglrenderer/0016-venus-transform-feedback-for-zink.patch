+static VkShaderStageFlags
+vkr_pipeline_layout_add_xfb(VkPipelineLayoutCreateInfo *info, VkPushConstantRange **copy)
+{
+   const uint32_t start = VKR_XFB_PC_OFFSET, end = VKR_XFB_PC_OFFSET + VKR_XFB_PC_SIZE;
+   const uint32_t count = info->pushConstantRangeCount;
+   const VkPushConstantRange *ranges = info->pPushConstantRanges;
+   int vertex = -1;
