+         .stageFlags = VK_SHADER_STAGE_VERTEX_BIT,
+         .offset = start,
+         .size = VKR_XFB_PC_SIZE,
+      };
+      info->pushConstantRangeCount = count + 1;
+      stages = VK_SHADER_STAGE_VERTEX_BIT;
+   }
