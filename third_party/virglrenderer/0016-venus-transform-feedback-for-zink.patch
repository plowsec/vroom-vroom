+   ADDRESSING_PHYSICAL_STORAGE_BUFFER64 = 5348,
+   EXEC_MODEL_VERTEX = 0,
+   EXEC_MODE_XFB = 11,
+   MEMORY_ACCESS_ALIGNED = 2,
+};
+
+/* Limits that keep the work bounded; real shaders stay far below. */
+#define MAX_ITEMS 64
+#define MAX_COMPONENTS 128
+#define MAX_ARRAY 32
+#define NONE 0xffffffffu
+
+struct type {
+   uint16_t op;
+   uint32_t a, b; /* int/float: width, signedness; vector/array: element, count; pointer: storage, type */
+};
+
+struct var {
+   uint32_t id;
+   uint32_t storage;
+   uint32_t type; /* pointee */
+};
+
+struct item {
+   uint32_t var;
+   uint32_t type;     /* pointee */
+   uint32_t elems;    /* array length, 0: not an array */
+   uint32_t elem;     /* element type (array) or the type itself */
+   uint32_t comps;    /* components of elem: 1 (scalar) to 4 */
+   uint32_t scalar;   /* scalar type id */
+   bool scalar_uint;  /* no bitcast needed */
+   uint32_t buffer;
+   uint32_t offset;
+};
+
+struct out {
+   uint32_t *w;
+   size_t n, cap;
+   bool oom;
+};
+
+static void
+put(struct out *o, uint32_t v)
+{
+   if (o->n == o->cap) {
+      size_t cap = o->cap ? o->cap * 2 : 1024;
+      uint32_t *w = realloc(o->w, cap * sizeof(*w));
+      if (!w) {
+         o->oom = true;
+         return;
+      }
+      o->w = w;
+      o->cap = cap;
+   }
+   o->w[o->n++] = v;
+}
