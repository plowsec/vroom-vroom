+
+enum {
+   DEC_BLOCK = 2,
+   DEC_BUILTIN = 11,
+   DEC_OFFSET = 35,
+   DEC_XFB_BUFFER = 36,
+   DEC_XFB_STRIDE = 37,
+   BUILTIN_VERTEX_INDEX = 42,
+   BUILTIN_INSTANCE_INDEX = 43,
+   SC_INPUT = 1,
+   SC_OUTPUT = 3,
+   SC_PUSH_CONSTANT = 9,
