+{
+   if (!physical_dev->zink)
+      return;
+   VkFormatFeatureFlags add = 0;
+   if (vkr_physical_device_nearest_format(physical_dev, format, true) != format)
+      add |= VK_FORMAT_FEATURE_VERTEX_BUFFER_BIT;
+   if (vkr_physical_device_nearest_format(physical_dev, format, false) != format)
+      add |= VK_FORMAT_FEATURE_UNIFORM_TEXEL_BUFFER_BIT;
+   props->bufferFeatures |= add;
+   if (props3)
+      props3->bufferFeatures |= add;
+}
