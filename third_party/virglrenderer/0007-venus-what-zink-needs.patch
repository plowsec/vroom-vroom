+/* robustness2 nullDescriptor on a host without it (MoltenVK).  Zink, Mesa's
+ * OpenGL on Vulkan, needs it.  A null image view, buffer or buffer view in a
+ * descriptor becomes one of a few small objects, cleared to zero once, so
+ * reads give zeros as the spec asks.  Shaders can't write the read-only
+ * ones; writes to the storage ones land there instead of nowhere.
+ */
+#define VKR_NULL_BUFFER_SIZE (64 * 1024)
+
+static void
+vkr_device_destroy_null_descriptors(struct vkr_device *dev)
+{
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   VkDevice device = dev->base.handle.device;
+   struct vkr_null_descriptors *n = &dev->null_desc;
+
+   if (n->image_view)
+      vk->DestroyImageView(device, n->image_view, NULL);
+   if (n->storage_image_view)
+      vk->DestroyImageView(device, n->storage_image_view, NULL);
+   if (n->texel_view)
+      vk->DestroyBufferView(device, n->texel_view, NULL);
+   if (n->storage_texel_view)
+      vk->DestroyBufferView(device, n->storage_texel_view, NULL);
+   if (n->image)
+      vk->DestroyImage(device, n->image, NULL);
+   if (n->storage_image)
+      vk->DestroyImage(device, n->storage_image, NULL);
+   if (n->buffer)
+      vk->DestroyBuffer(device, n->buffer, NULL);
+   if (n->storage_buffer)
+      vk->DestroyBuffer(device, n->storage_buffer, NULL);
+   for (uint32_t i = 0; i < ARRAY_SIZE(n->memory); i++) {
+      if (n->memory[i])
+         vk->FreeMemory(device, n->memory[i], NULL);
+   }
+   const bool enabled = n->enabled;
+   memset(n, 0, sizeof(*n));
+   n->enabled = enabled;
+}
+
+static bool
+vkr_device_null_memory(struct vkr_device *dev,
+                       const VkMemoryRequirements *req,
+                       VkDeviceMemory *mem)
+{
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   const VkPhysicalDeviceMemoryProperties *props =
+      &dev->physical_device->memory_properties;
+   uint32_t type = UINT32_MAX;
+
+   /* device local first */
+   for (uint32_t pass = 0; pass < 2 && type == UINT32_MAX; pass++) {
+      for (uint32_t i = 0; i < props->memoryTypeCount; i++) {
+         const VkMemoryPropertyFlags f = props->memoryTypes[i].propertyFlags;
+         if (!(req->memoryTypeBits & (1u << i)) ||
+             (f & VK_MEMORY_PROPERTY_LAZILY_ALLOCATED_BIT))
+            continue;
+         if (pass == 0 && !(f & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT))
+            continue;
+         type = i;
+         break;
+      }
+   }
+   if (type == UINT32_MAX)
+      return false;
+
+   const VkMemoryAllocateInfo info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = req->size,
+      .memoryTypeIndex = type,
+   };
+   return vk->AllocateMemory(dev->base.handle.device, &info, NULL, mem) == VK_SUCCESS;
+}
+
+static bool
+vkr_device_null_buffer(struct vkr_device *dev,
+                       VkBufferUsageFlags usage,
+                       VkBuffer *buf,
+                       VkDeviceMemory *mem,
+                       VkBufferView *view)
+{
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   VkDevice device = dev->base.handle.device;
+
+   const VkBufferCreateInfo info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = VKR_NULL_BUFFER_SIZE,
+      .usage = usage | VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+   };
+   if (vk->CreateBuffer(device, &info, NULL, buf) != VK_SUCCESS)
+      return false;
+   VkMemoryRequirements req;
+   vk->GetBufferMemoryRequirements(device, *buf, &req);
+   if (!vkr_device_null_memory(dev, &req, mem) ||
+       vk->BindBufferMemory(device, *buf, *mem, 0) != VK_SUCCESS)
+      return false;
+
+   const VkBufferViewCreateInfo view_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_VIEW_CREATE_INFO,
+      .buffer = *buf,
+      .format = VK_FORMAT_R8G8B8A8_UNORM,
+      .offset = 0,
+      .range = VK_WHOLE_SIZE,
+   };
+   return vk->CreateBufferView(device, &view_info, NULL, view) == VK_SUCCESS;
+}
+
+static bool
+vkr_device_null_image(struct vkr_device *dev,
+                      VkImageUsageFlags usage,
+                      VkImage *img,
+                      VkDeviceMemory *mem,
+                      VkImageView *view)
+{
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   VkDevice device = dev->base.handle.device;
+
+   const VkImageCreateInfo info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .imageType = VK_IMAGE_TYPE_2D,
+      .format = VK_FORMAT_R8G8B8A8_UNORM,
+      .extent = { 1, 1, 1 },
+      .mipLevels = 1,
+      .arrayLayers = 1,
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_OPTIMAL,
+      .usage = usage | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+      .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+   };
+   if (vk->CreateImage(device, &info, NULL, img) != VK_SUCCESS)
+      return false;
+   VkMemoryRequirements req;
+   vk->GetImageMemoryRequirements(device, *img, &req);
+   if (!vkr_device_null_memory(dev, &req, mem) ||
+       vk->BindImageMemory(device, *img, *mem, 0) != VK_SUCCESS)
+      return false;
+
+   const VkImageViewCreateInfo view_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+      .image = *img,
+      .viewType = VK_IMAGE_VIEW_TYPE_2D,
+      .format = VK_FORMAT_R8G8B8A8_UNORM,
+      .subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 },
+   };
+   return vk->CreateImageView(device, &view_info, NULL, view) == VK_SUCCESS;
+}
+
+/* Zero the objects once, on the device's first queue, and wait. */
+static bool
+vkr_device_null_clear(struct vkr_device *dev)
+{
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   VkDevice device = dev->base.handle.device;
+   struct vkr_null_descriptors *n = &dev->null_desc;
+
+   if (list_is_empty(&dev->queues))
+      return false;
+   struct vkr_queue *queue =
+      list_first_entry(&dev->queues, struct vkr_queue, base.track_head);
+
+   VkCommandPool pool = VK_NULL_HANDLE;
+   VkCommandBuffer cmd = VK_NULL_HANDLE;
+   VkFence fence = VK_NULL_HANDLE;
+   bool ok = false;
+
+   const VkCommandPoolCreateInfo pool_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+      .queueFamilyIndex = queue->family,
+   };
+   const VkFenceCreateInfo fence_info = { .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+   if (vk->CreateCommandPool(device, &pool_info, NULL, &pool) != VK_SUCCESS)
+      return false;
+   if (vk->CreateFence(device, &fence_info, NULL, &fence) != VK_SUCCESS)
+      goto out;
+   const VkCommandBufferAllocateInfo alloc_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+      .commandPool = pool,
+      .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+      .commandBufferCount = 1,
+   };
+   if (vk->AllocateCommandBuffers(device, &alloc_info, &cmd) != VK_SUCCESS)
+      goto out;
+   const VkCommandBufferBeginInfo begin = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+   };
+   if (vk->BeginCommandBuffer(cmd, &begin) != VK_SUCCESS)
+      goto out;
+
+   const VkImageSubresourceRange range = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+   const VkImage images[2] = { n->image, n->storage_image };
+   VkImageMemoryBarrier barriers[2];
+   for (uint32_t i = 0; i < 2; i++) {
+      barriers[i] = (VkImageMemoryBarrier){
+         .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+         .srcAccessMask = 0,
+         .dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+         .oldLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+         .newLayout = VK_IMAGE_LAYOUT_GENERAL,
+         .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+         .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+         .image = images[i],
+         .subresourceRange = range,
+      };
+   }
+   vk->CmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                          VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0, NULL, 2,
+                          barriers);
+   const VkClearColorValue zero = { .uint32 = { 0, 0, 0, 0 } };
+   for (uint32_t i = 0; i < 2; i++)
+      vk->CmdClearColorImage(cmd, images[i], VK_IMAGE_LAYOUT_GENERAL, &zero, 1, &range);
+   vk->CmdFillBuffer(cmd, n->buffer, 0, VK_WHOLE_SIZE, 0);
+   vk->CmdFillBuffer(cmd, n->storage_buffer, 0, VK_WHOLE_SIZE, 0);
+   const VkMemoryBarrier done = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+      .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+      .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT,
+   };
+   vk->CmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                          VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &done, 0, NULL, 0,
+                          NULL);
+   if (vk->EndCommandBuffer(cmd) != VK_SUCCESS)
+      goto out;
+
+   const VkSubmitInfo submit = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .commandBufferCount = 1,
+      .pCommandBuffers = &cmd,
+   };
+   mtx_lock(&queue->vk_mutex);
+   VkResult result = vk->QueueSubmit(queue->base.handle.queue, 1, &submit, fence);
+   mtx_unlock(&queue->vk_mutex);
+   if (result == VK_SUCCESS)
+      ok = vk->WaitForFences(device, 1, &fence, VK_TRUE, 5000000000ull) == VK_SUCCESS;
+
+out:
+   if (fence)
+      vk->DestroyFence(device, fence, NULL);
+   vk->DestroyCommandPool(device, pool, NULL);
+   return ok;
+}
+
+static bool
+vkr_device_null_ready(struct vkr_device *dev)
+{
+   struct vkr_null_descriptors *n = &dev->null_desc;
+   if (n->tried)
+      return n->ok;
+
+   const bool ok =
+      vkr_device_null_buffer(dev,
+                             VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT |
+                                VK_BUFFER_USAGE_UNIFORM_TEXEL_BUFFER_BIT |
+                                VK_BUFFER_USAGE_VERTEX_BUFFER_BIT |
+                                VK_BUFFER_USAGE_INDEX_BUFFER_BIT,
+                             &n->buffer, &n->memory[0], &n->texel_view) &&
+      vkr_device_null_buffer(dev,
+                             VK_BUFFER_USAGE_STORAGE_BUFFER_BIT |
+                                VK_BUFFER_USAGE_STORAGE_TEXEL_BUFFER_BIT,
+                             &n->storage_buffer, &n->memory[1], &n->storage_texel_view) &&
+      vkr_device_null_image(dev, 0, &n->image, &n->memory[2], &n->image_view) &&
+      vkr_device_null_image(dev, VK_IMAGE_USAGE_STORAGE_BIT, &n->storage_image,
+                            &n->memory[3], &n->storage_image_view) &&
+      vkr_device_null_clear(dev);
+   if (!ok) {
+      vkr_log("cannot emulate null descriptors: they stay null");
+      vkr_device_destroy_null_descriptors(dev);
+   }
+   n->tried = true;
+   n->ok = ok;
+   return ok;
+}
+
+void
+vkr_device_fill_null_descriptors(struct vkr_device *dev,
+                                 uint32_t count,
+                                 const VkWriteDescriptorSet *writes)
+{
+   if (!dev->null_desc.enabled || !writes)
+      return;
+
+   for (uint32_t i = 0; i < count; i++) {
+      const VkWriteDescriptorSet *w = &writes[i];
+
+      switch (w->descriptorType) {
+      case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+      case VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER:
+      case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE: {
+         VkDescriptorImageInfo *info = (VkDescriptorImageInfo *)w->pImageInfo;
+         const bool storage = w->descriptorType == VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+         for (uint32_t j = 0; info && j < w->descriptorCount; j++) {
+            if (info[j].imageView || !vkr_device_null_ready(dev))
+               continue;
+            info[j].imageView =
+               storage ? dev->null_desc.storage_image_view : dev->null_desc.image_view;
+            info[j].imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+         }
+         break;
+      }
+      case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:
+      case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER: {
+         VkBufferView *views = (VkBufferView *)w->pTexelBufferView;
+         const bool storage = w->descriptorType == VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER;
+         for (uint32_t j = 0; views && j < w->descriptorCount; j++) {
+            if (views[j] || !vkr_device_null_ready(dev))
+               continue;
+            views[j] =
+               storage ? dev->null_desc.storage_texel_view : dev->null_desc.texel_view;
+         }
+         break;
+      }
+      case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER:
+      case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC:
+      case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:
+      case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC: {
+         VkDescriptorBufferInfo *info = (VkDescriptorBufferInfo *)w->pBufferInfo;
+         const bool storage =
+            w->descriptorType == VK_DESCRIPTOR_TYPE_STORAGE_BUFFER ||
+            w->descriptorType == VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC;
+         for (uint32_t j = 0; info && j < w->descriptorCount; j++) {
+            if (info[j].buffer || !vkr_device_null_ready(dev))
+               continue;
+            info[j].buffer = storage ? dev->null_desc.storage_buffer : dev->null_desc.buffer;
+            info[j].offset = 0;
+            info[j].range = VK_WHOLE_SIZE;
+         }
+         break;
+      }
+      default:
+         break;
+      }
+   }
+}
+
+void
+vkr_device_fill_null_vertex_buffers(struct vkr_device *dev,
+                                    uint32_t count,
+                                    const VkBuffer *buffers,
+                                    const VkDeviceSize *offsets,
+                                    const VkDeviceSize *sizes)
+{
+   if (!dev->null_desc.enabled || !buffers)
+      return;
+
+   for (uint32_t i = 0; i < count; i++) {
+      if (buffers[i] || !vkr_device_null_ready(dev))
+         continue;
+      ((VkBuffer *)buffers)[i] = dev->null_desc.buffer;
+      if (offsets)
+         ((VkDeviceSize *)offsets)[i] = 0;
+      if (sizes)
+         ((VkDeviceSize *)sizes)[i] = VK_WHOLE_SIZE;
+   }
+}
