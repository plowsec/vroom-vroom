+/* Formats Metal lacks that zink needs for OpenGL 3.3 and 4.0 (see
+ * vkr_physical_device.h): offered, and read through the nearest one. */
+VkFormat
+vkr_physical_device_nearest_format(const struct vkr_physical_device *physical_dev,
+                                   VkFormat format,
+                                   bool vertex)
+{
+   if (!physical_dev->zink)
+      return format;
+   if (vertex) {
+      switch (format) {
+      case VK_FORMAT_A2B10G10R10_USCALED_PACK32:
+      case VK_FORMAT_A2R10G10B10_USCALED_PACK32:
+      case VK_FORMAT_A2R10G10B10_UNORM_PACK32:
+         return VK_FORMAT_A2B10G10R10_UNORM_PACK32;
+      case VK_FORMAT_A2B10G10R10_SSCALED_PACK32:
+      case VK_FORMAT_A2R10G10B10_SSCALED_PACK32:
+      case VK_FORMAT_A2R10G10B10_SNORM_PACK32:
+         return VK_FORMAT_A2B10G10R10_SNORM_PACK32;
+      default:
+         return format;
+      }
+   }
+   switch (format) {
+   case VK_FORMAT_R32G32B32_SFLOAT:
+      return VK_FORMAT_R32G32B32A32_SFLOAT;
+   case VK_FORMAT_R32G32B32_UINT:
+      return VK_FORMAT_R32G32B32A32_UINT;
+   case VK_FORMAT_R32G32B32_SINT:
+      return VK_FORMAT_R32G32B32A32_SINT;
+   default:
+      return format;
+   }
+}
