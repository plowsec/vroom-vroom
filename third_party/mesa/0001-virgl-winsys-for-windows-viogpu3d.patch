diff --git a/src/gallium/winsys/virgl/win32/virgl_win32_public.h b/src/gallium/winsys/virgl/win32/virgl_win32_public.h
--- a/src/gallium/winsys/virgl/win32/virgl_win32_public.h
+++ b/src/gallium/winsys/virgl/win32/virgl_win32_public.h
@@ -0,0 +1,14 @@
+/*
+ * Copyright 2026 vroom authors
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef VIRGL_WIN32_PUBLIC_H
+#define VIRGL_WIN32_PUBLIC_H
+
+struct pipe_screen;
+
+/* A virgl screen on the Windows virtio-gpu 3D driver (viogpu3d), for an
