+static void
+virtgpu_loss_track(struct virtgpu *gpu, bool track)
+{
+   AcquireSRWLockExclusive(&virtgpu_loss.lock);
+   if (!virtgpu_loss.gpus.next)
+      list_inithead(&virtgpu_loss.gpus);
