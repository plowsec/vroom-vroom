+static LONG WINAPI
+virtgpu_loss_fault(EXCEPTION_POINTERS *e)
+{
+   const EXCEPTION_RECORD *r = e->ExceptionRecord;
+   if (r->ExceptionCode != EXCEPTION_ACCESS_VIOLATION ||
+       r->NumberParameters < 2)
+      return EXCEPTION_CONTINUE_SEARCH;
+   const uintptr_t addr = r->ExceptionInformation[1];
+
+   LONG ret = EXCEPTION_CONTINUE_SEARCH;
+   AcquireSRWLockExclusive(&virtgpu_loss.lock);
+   struct virtgpu_window *hit = NULL;
+   util_dynarray_foreach(&virtgpu_loss.windows, struct virtgpu_window, w) {
+      if (addr - w->base < w->size)
+         hit = w;
+   }
+   if (hit) {
+      /* They all go at once; one the KMD still maps stays as it is. */
+      util_dynarray_foreach(&virtgpu_loss.windows, struct virtgpu_window, w) {
+         if (!w->replaced &&
+             VirtualAlloc((void *)w->base, w->size, MEM_RESERVE | MEM_COMMIT,
+                          PAGE_READWRITE) == (void *)w->base)
+            w->replaced = true;
+      }
+      if (hit->replaced) {
+         virtgpu_lose_locked();
+         ret = EXCEPTION_CONTINUE_EXECUTION;
+      }
+   }
+   ReleaseSRWLockExclusive(&virtgpu_loss.lock);
+   return ret;
+}
