+static void
+virtgpu_window_add(void *base, size_t size)
+{
+   const struct virtgpu_window w = {
+      .base = (uintptr_t)base,
+      .size = align64(size, 4096),
+   };
+   AcquireSRWLockExclusive(&virtgpu_loss.lock);
+   if (!virtgpu_loss.handler)
+      virtgpu_loss.handler = AddVectoredExceptionHandler(1, virtgpu_loss_fault);
+   util_dynarray_append_typed(&virtgpu_loss.windows, struct virtgpu_window, w);
+   ReleaseSRWLockExclusive(&virtgpu_loss.lock);
+}
+
+static void
+virtgpu_window_remove(void *base)
+{
+   if (!base)
+      return;
+   AcquireSRWLockExclusive(&virtgpu_loss.lock);
+   util_dynarray_foreach(&virtgpu_loss.windows, struct virtgpu_window, w) {
+      if (w->base == (uintptr_t)base) {
+         if (w->replaced)
+            VirtualFree(base, 0, MEM_RELEASE);
+         *w = util_dynarray_pop(&virtgpu_loss.windows, struct virtgpu_window);
+         break;
+      }
+   }
+   ReleaseSRWLockExclusive(&virtgpu_loss.lock);
+}
