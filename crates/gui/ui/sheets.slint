// Things that float over the library: New VM, command palette, confirm
// dialog, toasts.

import { Theme, OsLook } from "theme.slint";
import { Icons } from "icons.slint";
import { Bus } from "bus.slint";
import { NewVm, HostInfo, Toast, PaletteItem } from "types.slint";
import { Button, IconButton, Toggle, Slider, Field, Icon, OsBadge, Banner, Row, Select, Tip } from "controls.slint";

component Scrim inherits Rectangle {
    callback dismiss;
    background: Theme.scrim;
    TouchArea {
        clicked => { root.dismiss(); }
    }
}

component Panel inherits Rectangle {
    border-radius: Theme.r-xl;
    background: Theme.bg-raised;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 30px;
    drop-shadow-color: #00000059;
    drop-shadow-offset-y: 8px;
    // Swallow clicks so they don't reach the scrim.
    TouchArea { }
}

component OsTile inherits Rectangle {
    in property <string> os;
    in property <string> label;
    in property <bool> selected;
    in property <string> tip;
    callback clicked;
    height: 88px;
    Tip {
        text: root.tip;
    }
    border-radius: Theme.r-lg;
    background: selected ? Theme.selected : ta.has-hover ? Theme.card-hover : Theme.card;
    border-width: selected ? 2px : 1px;
    border-color: selected ? Theme.accent : Theme.border;
    animate background, border-color { duration: 150ms; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        alignment: center;
        spacing: 9px;
        HorizontalLayout {
            alignment: center;
            OsBadge {
                os: root.os;
                size: 38px;
            }
        }
        Text {
            text: root.label;
            font-size: Theme.fs-sm;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: center;
        }
    }
}

export component NewVmSheet inherits Rectangle {
    in-out property <NewVm> draft;
    in property <HostInfo> host;
    in property <string> dest;
    in property <string> error;
    in property <bool> creating;
    // A ready-made VM being made: what it does now.
    in property <string> progress;
    // The Mac user's SSH public keys (~/.ssh/*.pub).
    in property <[string]> keys;
    property <bool> windows: draft.os-index == 1;
    property <[{os: string, label: string, index: int, tip: string}]> tiles: [
        { os: "ubuntu", label: "Ubuntu", index: 0, tip: "" },
        { os: "windows", label: "Windows 11", index: 1, tip: "NVMe disks, a TPM and 8 GB of memory. Setup runs on its own and installs the guest tools." },
        { os: "debian", label: "Debian", index: 2, tip: "" },
        { os: "fedora", label: "Fedora", index: 3, tip: "" },
        { os: "linux", label: "Other Linux", index: 5, tip: "" },
    ];

    Scrim {
        dismiss => { Bus.act("newvm.cancel"); }
    }
    Panel {
        width: min(780px, root.width - 60px);
        height: min(l.preferred-height, root.height - 40px);
        l := VerticalLayout {
            padding: 28px;
            spacing: 18px;
            HorizontalLayout {
                spacing: 12px;
                Text {
                    horizontal-stretch: 1;
                    text: "New VM";
                    font-size: 20px;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                IconButton {
                    icon: Icons.x;
                    tip: "Close (esc)";
                    clicked => { Bus.act("newvm.cancel"); }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                for t in root.tiles: OsTile {
                    horizontal-stretch: 1;
                    preferred-width: 100px;
                    min-width: 90px;
                    os: t.os;
                    label: t.label;
                    tip: t.tip;
                    selected: root.draft.os-index == t.index;
                    clicked => { Bus.set("newvm.os", t.index); }
                }
            }
            // Installer.
            Rectangle {
                height: 66px;
                border-radius: Theme.r-lg;
                background: ita.has-hover ? Theme.card-hover : Theme.card;
                border-width: 1px;
                border-color: Theme.border-strong;
                ita := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Bus.act("newvm.pick"); }
                }
                Tip {
                    text: root.windows ? (root.draft.ready ? "Installs on its own: virtio drivers (network at once), guest tools, SSH if on. Download the ISO from microsoft.com."
                            : "The Windows 11 ARM64 ISO (installs on its own), or an install stick image.")
                        : root.draft.ready ? "Downloads Ubuntu's cloud image (600 MB) and sets it up at first boot. Or choose an ISO or a cloud image (.img)."
                        : "An ARM64 installer image. Optional: you can attach one later.";
                }
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 14px;
                    spacing: 14px;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.r-md;
                        background: Theme.well;
                        Icon {
                            source: root.draft.installer != "" ? Icons.disc : Icons.upload;
                            tint: Theme.text-2;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: root.draft.installer != "" ? root.draft.installer
                                : root.windows ? "Windows 11 ARM64 ISO"
                                : root.draft.ready ? "Ubuntu 24.04, ready to use" : "Installer ISO";
                            font-size: Theme.fs-md;
                            font-weight: 600;
                            color: root.draft.installer != "" || root.draft.ready ? Theme.text : Theme.text-2;
                            overflow: elide;
                        }
                    }
                    if root.draft.installer != "": IconButton {
                        icon: Icons.x;
                        tip: "No installer";
                        y: (parent.height - self.height) / 2;
                        clicked => { Bus.act("newvm.clear-installer"); }
                    }
                }
            }
            HorizontalLayout {
                spacing: 18px;
                VerticalLayout {
                    width: 220px;
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: "Name";
                        font-size: Theme.fs-sm;
                        font-weight: 600;
                        color: Theme.text-2;
                    }
                    Rectangle {
                        height: 32px;
                        Field {
                            text: root.draft.name;
                            mono: true;
                            edited(t) => { root.draft.name = t; }
                        }
                        Tip {
                            text: "Letters, digits, . _ -";
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    HorizontalLayout {
                        Text {
                            text: "CPUs";
                            font-size: Theme.fs-sm;
                            font-weight: 600;
                            color: Theme.text-2;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: round(cpu.shown);
                            font-size: Theme.fs-sm;
                            font-weight: 700;
                            color: Theme.text;
                        }
                    }
                    cpu := Slider {
                        minimum: 1;
                        maximum: root.host.cpus;
                        sweet-max: max(1, root.host.cpus - 2);
                        value: root.draft.cpus;
                        unit: "CPUs";
                        released(v) => { root.draft.cpus = round(v); }
                    }
                    HorizontalLayout {
                        Text {
                            text: "Memory";
                            font-size: Theme.fs-sm;
                            font-weight: 600;
                            color: Theme.text-2;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: round(mem.shown) + " GB";
                            font-size: Theme.fs-sm;
                            font-weight: 700;
                            color: Theme.text;
                        }
                    }
                    mem := Slider {
                        minimum: 1;
                        maximum: max(2, root.host.memory-gib);
                        sweet-max: max(1, root.host.memory-gib * 0.6);
                        value: root.draft.memory-gib;
                        unit: "GB";
                        released(v) => { root.draft.memory-gib = round(v); }
                    }
                    Rectangle {
                        height: dl.preferred-height;
                        dl := HorizontalLayout {
                            Text {
                                text: "Disk";
                                font-size: Theme.fs-sm;
                                font-weight: 600;
                                color: Theme.text-2;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: round(disk.shown) + " GB";
                                font-size: Theme.fs-sm;
                                font-weight: 700;
                                color: Theme.text;
                            }
                        }
                        Tip {
                            text: "The most it can hold. The file only takes the space the guest fills.";
                        }
                    }
                    disk := Slider {
                        minimum: 8;
                        maximum: 1024;
                        step: 8;
                        value: root.draft.disk-gib;
                        unit: "GB";
                        released(v) => { root.draft.disk-gib = round(v); }
                    }
                }
            }
            // Ready-made: who uses it, and SSH.
            if root.draft.ready: HorizontalLayout {
                spacing: 18px;
                VerticalLayout {
                    width: 180px;
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: "User";
                        font-size: Theme.fs-sm;
                        font-weight: 600;
                        color: Theme.text-2;
                    }
                    Field {
                        text: root.draft.user;
                        mono: true;
                        edited(t) => { root.draft.user = t; }
                    }
                }
                VerticalLayout {
                    width: 180px;
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: "Password";
                        font-size: Theme.fs-sm;
                        font-weight: 600;
                        color: Theme.text-2;
                    }
                    Field {
                        text: root.draft.password;
                        input-type: InputType.password;
                        edited(t) => { root.draft.password = t; }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;
                    alignment: start;
                    Rectangle {
                        height: sl.preferred-height;
                        sl := HorizontalLayout {
                            spacing: 8px;
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: root.draft.ssh;
                                toggled(v) => { root.draft.ssh = v; }
                            }
                            Text {
                                text: "SSH";
                                font-size: Theme.fs-sm;
                                font-weight: 600;
                                color: Theme.text-2;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Tip {
                            text: "An SSH server with this key of yours, and a port on your Mac for it (in the VM's file).";
                        }
                    }
                    if root.draft.ssh: Select {
                        options: root.keys;
                        current: root.draft.ssh-key;
                        empty-text: "No key in ~/.ssh";
                        selected(i) => { root.draft.ssh-key = i; }
                    }
                }
            }
            HorizontalLayout {
                spacing: 24px;
                if root.draft.ready && !root.windows: Rectangle {
                    width: dsk.preferred-width;
                    dsk := HorizontalLayout {
                        spacing: 10px;
                        Toggle {
                            y: (parent.height - self.height) / 2;
                            checked: root.draft.desktop;
                            toggled(v) => { root.draft.desktop = v; }
                        }
                        Text {
                            text: "Desktop";
                            font-size: Theme.fs-md;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }
                    Tip {
                        text: "Ubuntu's desktop (GNOME): about 10 more minutes at first boot.";
                    }
                }
                if !root.windows: Rectangle {
                    width: gl.preferred-width;
                    gl := HorizontalLayout {
                        spacing: 10px;
                        Toggle {
                            y: (parent.height - self.height) / 2;
                            checked: root.draft.gpu3d;
                            toggled(v) => { root.draft.gpu3d = v; }
                        }
                        Text {
                            text: "3D graphics";
                            font-size: Theme.fs-md;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }
                    Tip {
                        text: "Drawn by your Mac's GPU: Vulkan and OpenGL. Needs the 3D libraries (see the guide).";
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Toggle {
                        y: (parent.height - self.height) / 2;
                        checked: root.draft.start;
                        toggled(v) => { root.draft.start = v; }
                    }
                    Text {
                        text: "Start it right away";
                        font-size: Theme.fs-md;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.creating && root.progress != "": Banner {
                kind: 0;
                text: root.progress;
            }
            if root.error != "": Banner {
                kind: 3;
                text: root.error;
            }
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: Theme.r-md;
                    background: lta.has-hover ? Theme.card-hover : transparent;
                    lta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Bus.act("newvm.location"); }
                    }
                    Tip {
                        text: "Where the VM's file and disk go. Click to choose another folder: the next VMs go there too.";
                    }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 8px;
                        Icon {
                            source: Icons.folder;
                            width: 15px;
                            height: 15px;
                            y: (parent.height - self.height) / 2;
                            tint: Theme.text-3;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.dest;
                            font-size: Theme.fs-xs;
                            font-family: Theme.mono;
                            color: Theme.text-3;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: "Change…";
                            font-size: Theme.fs-xs;
                            font-weight: 600;
                            color: lta.has-hover ? Theme.accent : Theme.text-2;
                            vertical-alignment: center;
                        }
                    }
                }
                Button {
                    text: "Cancel";
                    kind: "ghost";
                    clicked => { Bus.act("newvm.cancel"); }
                }
                Button {
                    text: "Create";
                    kind: "primary";
                    busy: root.creating;
                    enabled: root.draft.name != "";
                    clicked => { Bus.act("newvm.create"); }
                }
            }
        }
    }
}

export component CommandPalette inherits Rectangle {
    in property <[PaletteItem]> items;
    in property <int> selected;
    in-out property <string> query;
    callback opened;
    Scrim {
        dismiss => { Bus.act("palette.close"); }
    }
    Panel {
        x: (root.width - self.width) / 2;
        y: max(40px, root.height * 0.14);
        width: min(620px, root.width - 60px);
        height: pl.preferred-height;
        pl := VerticalLayout {
            padding: 10px;
            spacing: 6px;
            HorizontalLayout {
                padding-left: 8px;
                spacing: 8px;
                Icon {
                    source: Icons.search;
                    y: (parent.height - self.height) / 2;
                    tint: Theme.text-3;
                }
                input := Field {
                    horizontal-stretch: 1;
                    height: 42px;
                    text <=> root.query;
                    placeholder: "Search";

                    edited(t) => {
                        root.query = t;
                        Bus.search("palette:" + t);
                    }
                    init => { self.focus-input(); }
                }
            }
            for it[i] in root.items: Rectangle {
                height: 38px;
                border-radius: Theme.r-md;
                background: i == root.selected ? Theme.selected : transparent;
                ita := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Bus.act("palette.run:" + i); }
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    Icon {
                        source: Icons.by-name(it.icon);
                        y: (parent.height - self.height) / 2;
                        tint: i == root.selected ? Theme.text : Theme.text-2;
                    }
                    Text {
                        text: it.title;
                        font-size: Theme.fs-md;
                        font-weight: i == root.selected ? 600 : 500;
                        color: Theme.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Text {
                        text: it.hint;
                        font-size: Theme.fs-xs;
                        color: Theme.text-3;
                        vertical-alignment: center;
                    }
                }
            }
            if root.items.length == 0: Text {
                text: "Nothing found.";
                font-size: Theme.fs-md;
                color: Theme.text-3;
                horizontal-alignment: center;
                height: 44px;
                vertical-alignment: center;
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-top: 2px;
                spacing: 14px;
                Text {
                    text: "↑↓   ↵   esc";
                    font-size: Theme.fs-xs;
                    color: Theme.text-3;
                }
            }
        }
    }
}

export struct ConfirmInfo {
    title: string,
    text: string,
    ok: string,
    danger: bool,
    action: string,
    // A third button (empty: none) and what it does; the dialog stays.
    alt: string,
    alt-action: string,
}

export component ConfirmDialog inherits Rectangle {
    in property <ConfirmInfo> info;
    Scrim {
        dismiss => { Bus.act("confirm.cancel"); }
    }
    Panel {
        width: min(440px, root.width - 60px);
        height: cl.preferred-height;
        cl := VerticalLayout {
            padding: 24px;
            spacing: 14px;
            Text {
                text: root.info.title;
                font-size: Theme.fs-xl;
                font-weight: 700;
                color: Theme.text;
                wrap: word-wrap;
            }
            Text {
                text: root.info.text;
                font-size: Theme.fs-md;
                color: Theme.text-2;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 10px;
                if root.info.alt != "": Button {
                    text: root.info.alt;
                    kind: "ghost";
                    clicked => { Bus.act(root.info.alt-action); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "Cancel";
                    kind: "ghost";
                    clicked => { Bus.act("confirm.cancel"); }
                }
                Button {
                    text: root.info.ok;
                    kind: root.info.danger ? "danger" : "primary";
                    clicked => { Bus.act("confirm.ok"); }
                }
            }
        }
    }
}

export component RenameDialog inherits Rectangle {
    in-out property <string> name;
    in property <string> error;
    Scrim {
        dismiss => { Bus.act("rename.cancel"); }
    }
    Panel {
        width: min(440px, root.width - 60px);
        height: rl.preferred-height;
        rl := VerticalLayout {
            padding: 24px;
            spacing: 14px;
            Text {
                text: "Rename";
                font-size: Theme.fs-xl;
                font-weight: 700;
                color: Theme.text;
            }
            Text {
                text: "The VM file, its folder and its saved state take the new name. Its disks keep theirs, and the guest sees the same hardware.";
                font-size: Theme.fs-md;
                color: Theme.text-2;
                wrap: word-wrap;
            }
            Field {
                text: root.name;
                mono: true;
                // Return renames (the window's key handler).
                edited(t) => { root.name = t; }
                init => {
                    self.focus-input();
                    self.select-all();
                }
            }
            if root.error != "": Banner {
                kind: 3;
                text: root.error;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                Button {
                    text: "Cancel";
                    kind: "ghost";
                    clicked => { Bus.act("rename.cancel"); }
                }
                Button {
                    text: "Rename";
                    kind: "primary";
                    enabled: root.name != "";
                    clicked => { Bus.act("rename.ok"); }
                }
            }
        }
    }
}

component ToastView inherits Rectangle {
    in property <Toast> t;
    property <color> c: t.kind == 3 ? Theme.red : t.kind == 2 ? Theme.amber : t.kind == 1 ? Theme.green : Theme.text-2;
    height: max(44px, tl.preferred-height);
    width: min(420px, tl.preferred-width);
    border-radius: Theme.r-lg;
    background: Theme.popup;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000040;
    drop-shadow-offset-y: 4px;
    opacity: 0;
    init => { self.opacity = 1; }
    animate opacity { duration: 220ms; }
    tl := HorizontalLayout {
        padding: 10px;
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;
        Icon {
            source: root.t.kind == 1 ? Icons.check : root.t.kind == 0 ? Icons.info : Icons.warning;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            tint: root.c;
        }
        Text {
            text: root.t.text;
            font-size: Theme.fs-md;
            color: Theme.text;
            vertical-alignment: center;
            wrap: word-wrap;
            max-width: 320px;
        }
        if root.t.action != "": Button {
            small: true;
            kind: "ghost";
            text: "Show log";
            y: (parent.height - self.height) / 2;
            clicked => { Bus.act(root.t.action); }
        }
        IconButton {
            icon: Icons.x;
            size: 24px;
            y: (parent.height - self.height) / 2;
            clicked => { Bus.act("toast.close:" + root.t.id); }
        }
    }
}

export component Toasts inherits Rectangle {
    in property <[Toast]> items;
    VerticalLayout {
        alignment: end;
        spacing: 8px;
        padding: 18px;
        for t in root.items: HorizontalLayout {
            alignment: end;
            ToastView { t: t; }
        }
    }
}
