// The settings column. One card per area; a closed card says in one line
// what is set, an open card shows every option, the rare ones under
// "Advanced". There is no separate expert mode. Labels stay short: what
// an option does is in its tooltip, with its config key.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Bus } from "bus.slint";
import { VmSettings, CardVis, HostInfo, NetRow } from "types.slint";
import { Button, IconButton, Toggle, Segmented, Slider, Field, Select, Row, SectionCard, Divider, Banner, Icon, Tip, InfoTip, StatusDot } from "controls.slint";

component SubCard inherits Rectangle {
    border-radius: Theme.r-md;
    background: Theme.well;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 10px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 4px;
        @children
    }
}

// What waits (for the next start, a resume): a short line, the rest in
// its tip.
component Note inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    in property <image> icon: Icons.history;
    height: l.preferred-height;
    l := HorizontalLayout {
        spacing: 8px;
        Icon {
            source: root.icon;
            width: 14px;
            height: 14px;
            y: 1px;
            tint: Theme.text-3;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: Theme.fs-xs;
            color: Theme.text-2;
            overflow: elide;
        }
    }
    Tip {
        text: root.tip != "" ? root.tip : root.text;
    }
}

component Value inherits Text {
    font-size: Theme.fs-md;
    font-weight: 600;
    color: Theme.text;
    vertical-alignment: center;
    horizontal-alignment: right;
    min-width: 54px;
}

// vroom-netd, the root helper bridged and host-only networks need: a
// line that says whether it runs, and the button that sets it up.
component NetdLine inherits Rectangle {
    in property <HostInfo> host;
    property <bool> ready: host.netd == "ready";
    height: max(30px, l.preferred-height);
    Tip {
        text: root.ready ? "vroom-netd, vroom's helper that runs as root, is running. Bridged and host-only networks go through it."
            : root.host.netd == "stopped" ? "vroom-netd, the helper this needs (it runs as root), is installed but doesn't answer. Setting it up again starts it."
            : root.host.netd == "old" ? "vroom-netd, the helper this needs (it runs as root), is from an older vroom. Set it up again."
            : "This needs vroom-netd, a small helper that runs as root. It's set up once; macOS asks for an admin password.";
    }
    l := HorizontalLayout {
        spacing: 8px;
        if root.ready: StatusDot {
            y: (parent.height - self.height) / 2;
            tint: Theme.green;
        }
        if !root.ready: Icon {
            source: Icons.warning;
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            tint: Theme.amber;
        }
        Text {
            horizontal-stretch: 1;
            text: root.ready ? "vroom-netd" : root.host.netd == "stopped" ? "vroom-netd doesn't answer" : root.host.netd == "old" ? "vroom-netd is out of date" : "Needs vroom-netd";
            font-size: Theme.fs-sm;
            color: root.ready ? Theme.text-2 : Theme.amber;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.ready: Button {
            small: true;
            kind: "ghost";
            text: "Remove";
            tip: "Uninstall vroom-netd. macOS asks for an admin password.";
            y: (parent.height - self.height) / 2;
            clicked => { Bus.act("netd.remove"); }
        }
        if !root.ready: Button {
            small: true;
            kind: "primary";
            text: root.host.netd-busy ? "Waiting..." : "Set up";
            tip: "Installs vroom-netd. macOS asks for an admin password.";
            busy: root.host.netd-busy;
            y: (parent.height - self.height) / 2;
            clicked => { Bus.act("netd.setup"); }
        }
    }
}

component NetCard inherits SubCard {
    in property <NetRow> net;
    in property <int> index;
    in property <HostInfo> host;
    in property <bool> locked;
    property <string> k: "net." + index;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: "Adapter " + (root.index + 1);
            font-size: Theme.fs-sm;
            font-weight: 600;
            color: Theme.text-2;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        // The cable: in or out.
        Rectangle {
            width: 38px;
            Toggle {
                y: (parent.height - self.height) / 2;
                checked: root.net.connected;
                enabled: !root.locked;
                toggled(v) => { Bus.set(root.k + ".connected", v ? "true" : "false"); }
            }
            Tip {
                text: root.net.connected ? "Cable in" : "Cable out: the guest sees no network on this adapter";
                key: "connected";
            }
        }
        IconButton {
            icon: Icons.trash;
            tip: "Remove adapter";
            size: 28px;
            enabled: !root.locked;
            clicked => { Bus.act(root.k + ".remove"); }
        }
    }
    Segmented {
        options: ["NAT", "Bridged", "Host-only"];
        tips: [
            "The guest reaches the internet through this Mac. Nothing reaches the guest unless you forward a port.",
            "The guest sits on your network like a real machine.",
            "A private network for VMs and this Mac. No internet.",
        ];
        selected: root.net.mode;
        enabled: !root.locked;
        changed(i) => { Bus.set(root.k + ".mode", i); }
    }
    if root.net.note != "": Note {
        text: root.net.note;
    }
    // Bridged and host-only go through vroom-netd, which runs as root.
    if root.net.mode != 0 && root.host.netd != "": NetdLine {
        host: root.host;
    }
    if root.net.mode == 0: VerticalLayout {
        spacing: 4px;
        Divider { text: "PORT FORWARDS"; }
        for f[j] in root.net.forwards: HorizontalLayout {
            spacing: 6px;
            Field {
                width: 84px;
                text: f.host;
                prefix: "host";
                mono: true;
                input-type: number;
                enabled: !root.locked;
                committed(t) => { Bus.set(root.k + ".fwd." + j + ".host", t); }
            }
            Icon {
                source: Icons.arrow-right;
                width: 14px;
                y: (parent.height - self.height) / 2;
                tint: Theme.text-3;
            }
            Field {
                width: 88px;
                text: f.guest;
                prefix: "guest";
                mono: true;
                input-type: number;
                enabled: !root.locked;
                committed(t) => { Bus.set(root.k + ".fwd." + j + ".guest", t); }
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: lan.preferred-width;
                lan := HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "LAN";
                        font-size: Theme.fs-xs;
                        color: f.lan ? Theme.amber : Theme.text-3;
                        vertical-alignment: center;
                    }
                    Toggle {
                        y: (parent.height - self.height) / 2;
                        checked: f.lan;
                        danger: true;
                        enabled: !root.locked;
                        toggled(v) => { Bus.set(root.k + ".fwd." + j + ".lan", v ? "true" : "false"); }
                    }
                }
                Tip {
                    text: f.lan ? "Open to your network, not only this Mac" : "Only this Mac can connect. On: your network too.";
                    key: "host_addr";
                }
            }
            IconButton {
                icon: Icons.x;
                tip: "Remove";
                size: 28px;
                y: (parent.height - self.height) / 2;
                enabled: !root.locked;
                clicked => { Bus.act(root.k + ".fwd." + j + ".remove"); }
            }
        }
        HorizontalLayout {
            alignment: start;
            Button {
                small: true;
                kind: "ghost";
                text: "Port forward";
                tip: "A port on this Mac that leads to one in the guest";
                icon: Icons.plus;
                has-icon: true;
                enabled: !root.locked;
                clicked => { Bus.act(root.k + ".fwd.add"); }
            }
        }
        Row {
            label: "Reach this Mac's localhost";
            tip: "The guest can connect to services on 127.0.0.1 of this Mac. They often have no password.";
            key: "allow_host_loopback";
            warn: root.net.loopback;
            Toggle {
                y: (parent.height - self.height) / 2;
                checked: root.net.loopback;
                danger: true;
                enabled: !root.locked;
                toggled(v) => { Bus.set(root.k + ".loopback", v ? "true" : "false"); }
            }
        }
        Row {
            label: "Internet only";
            tip: "Block your local network: the guest reaches the internet only.";
            key: "block_private";
            Toggle {
                y: (parent.height - self.height) / 2;
                checked: root.net.block-private;
                enabled: !root.locked;
                toggled(v) => { Bus.set(root.k + ".block", v ? "true" : "false"); }
            }
        }
    }
    if root.net.mode == 1: Row {
        label: "Host interface";
        tip: "The network of this Mac the guest joins.";
        key: "interface";
        Select {
            width: 150px;
            options: root.host.interfaces;
            current: root.net.iface-index;
            empty-text: root.net.interface != "" ? root.net.interface : "Pick one";
            enabled: !root.locked;
            selected(i) => { Bus.set(root.k + ".iface", root.host.interfaces[i]); }
        }
    }
    if root.net.mode == 2: Row {
        label: "Network name";
        tip: "VMs with the same name see each other.";
        key: "network";
        Field {
            width: 150px;
            text: root.net.network;
            placeholder: "lab";
            enabled: !root.locked;
            committed(t) => { Bus.set(root.k + ".network", t); }
        }
    }
    Divider { text: "ADVANCED"; }
    Row {
        label: "MAC address";
        tip: "Empty: one made from the VM's identity.";
        key: "mac";
        HorizontalLayout {
            spacing: 4px;
            Field {
                width: 150px;
                text: root.net.mac;
                placeholder: "automatic";
                mono: true;
                enabled: !root.locked;
                committed(t) => { Bus.set(root.k + ".mac", t); }
            }
            IconButton {
                icon: Icons.dice;
                tip: "New random MAC";
                size: 30px;
                y: (parent.height - self.height) / 2;
                enabled: !root.locked;
                clicked => { Bus.act(root.k + ".mac.random"); }
            }
        }
    }
}

export component SettingsPanel inherits Rectangle {
    in property <VmSettings> s;
    in property <CardVis> vis;
    in property <HostInfo> host;
    in-out property <string> query;
    property <bool> lk: s.locked;
    property <bool> open-all: vis.searching;
    // The lock on each card that can't change now, and why in its tip.
    property <string> lock-tip: lk ? s.lock-why : "";
    property <string> live-tip: s.live ? "" : s.lock-why;

    VerticalLayout {
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            search := Field {
                horizontal-stretch: 1;
                text <=> root.query;
                placeholder: "Search settings";
                edited(t) => {
                    root.query = t;
                    Bus.search(t);
                }
            }
        }
        if root.s.locked: Banner {
            kind: 0;
            icon: Icons.lock;
            text: root.s.lock-short != "" ? root.s.lock-short : root.s.lock-reason;
            tip: root.s.lock-short != "" ? root.s.lock-reason : "";
        }
        for w[i] in root.s.warnings: Banner {
            kind: 2;
            text: i < root.s.warn-short.length ? root.s.warn-short[i] : w;
            tip: w;
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                spacing: 10px;
                padding-right: 10px;
                padding-bottom: 20px;

                if root.vis.hw: SectionCard {
                    icon: Icons.cpu;
                    title: "Processor and memory";
                    summary: root.s.sum-hw;
                    force-open: root.open-all;
                    lock-tip: root.lock-tip;
                    Row {
                        label: "CPUs";
                        key: "cpus";
                        tip: "Shaded: more than this Mac can spare.";
                        Value { text: cpus.shown; }
                    }
                    cpus := Slider {
                        minimum: 1;
                        maximum: root.host.cpus;
                        value: root.s.cpus;
                        sweet-max: max(1, root.host.cpus - 2);
                        unit: "CPUs";
                        enabled: !root.lk;
                        released(v) => { Bus.set("cpus", round(v)); }
                    }
                    Row {
                        label: "Memory";
                        key: "memory_mib";
                        tip: "Shaded: more than this Mac can spare.";
                        Value { text: mem.shown + " GB"; }
                    }
                    mem := Slider {
                        minimum: 1;
                        maximum: max(2, root.host.memory-gib);
                        value: root.s.memory-gib;
                        sweet-max: max(1, root.host.memory-gib * 0.6);
                        unit: "GB";
                        enabled: !root.lk;
                        released(v) => { Bus.set("memory", round(v)); }
                    }
                    Divider { text: "ADVANCED"; }
                    Row {
                        label: "Nested virtualization";
                        tip: "Run VMs inside this VM. M3 or newer. No snapshots then.";
                        key: "nested";
                        Toggle {
                            y: (parent.height - self.height) / 2;
                            checked: root.s.nested;
                            enabled: !root.lk;
                            toggled(v) => { Bus.set("nested", v ? "true" : "false"); }
                        }
                    }
                    Row {
                        label: "Guest system";
                        tip: "Only changes the icon and defaults.";
                        key: "os";
                        Select {
                            width: 130px;
                            options: ["Ubuntu", "Windows", "Debian", "Fedora", "Alpine", "Linux", "Other"];
                            current: root.s.os-index;
                            selected(i) => { Bus.set("os", i); }
                        }
                    }
                }

                if root.vis.display: SectionCard {
                    icon: Icons.display;
                    title: "Display";
                    summary: root.s.sum-display;
                    force-open: root.open-all;
                    lock-tip: root.lock-tip;
                    Segmented {
                        options: ["None", "2D", "3D"];
                        tips: [
                            "No screen. Use the serial console (vroom run).",
                            "Works everywhere. The guest follows the window size.",
                            "Drawn by your Mac's GPU: Vulkan and OpenGL in Linux, Direct3D 11 in Windows (with its 3D driver). Needs the 3D libraries (see the guide).",
                        ];
                        selected: root.s.gpu;
                        enabled: !root.lk;
                        changed(i) => { Bus.set("gpu", i); }
                    }
                    if root.s.gpu != 0: Row {
                        label: "Monitors";
                        tip: "Screens the guest gets, a window each. Closing one turns it off in the guest. The display button brings it back.";
                        key: "display.monitors";
                        Segmented {
                            y: (parent.height - self.height) / 2;
                            options: ["1", "2", "3", "4"];
                            selected: root.s.monitors - 1;
                            enabled: !root.lk;
                            changed(i) => { Bus.set("monitors", i + 1); }
                        }
                    }
                    if root.s.gpu != 0: Row {
                        label: "Full resolution on Retina";
                        tip: "The guest gets every pixel of the window and its tools scale its UI, so text is sharp. Guests without the tools get half and are scaled up.";
                        key: "display.hidpi";
                        Toggle {
                            y: (parent.height - self.height) / 2;
                            checked: root.s.hidpi;
                            toggled(v) => { Bus.set("hidpi", v ? "true" : "false"); }
                        }
                    }
                    if root.s.gpu == 2: Row {
                        label: "OpenGL";
                        tip: "Off: Vulkan only, and less host code faces the guest.";
                        key: "display.opengl";
                        Toggle {
                            y: (parent.height - self.height) / 2;
                            checked: root.s.opengl;
                            enabled: !root.lk;
                            toggled(v) => { Bus.set("opengl", v ? "true" : "false"); }
                        }
                    }
                    if root.s.gpu == 2 && root.s.opengl: Row {
                        label: "OpenGL driver";
                        key: "display.opengl_host";
                        HorizontalLayout {
                            spacing: 8px;
                            // ANGLE's OpenGL ES 3.0 has no multisample
                            // textures: Chrome draws without the GPU.
                            if root.s.opengl-host == 1: InfoTip {
                                y: (parent.height - self.height) / 2;
                                icon: Icons.warning;
                                tint: Theme.amber;
                                text: "Chrome and Chromium fall back to software rendering with ANGLE.";
                            }
                            Segmented {
                                y: (parent.height - self.height) / 2;
                                width: 170px;
                                options: ["Apple", "ANGLE"];
                                tips: [
                                    "Your Mac's own OpenGL. The guest gets OpenGL 4.1, enough for most Linux apps.",
                                    "ANGLE checks every call before your Mac's GPU sees it, but the guest only gets OpenGL 2.1: many apps won't start, and Chrome and Chromium draw without the GPU.",
                                ];
                                selected: root.s.opengl-host;
                                enabled: !root.lk;
                                changed(i) => { Bus.set("opengl_host", i); }
                            }
                        }
                    }
                    Row {
                        label: "Hardware video decoding";
                        tip: "Linux guests: H.264 and HEVC decoded by your Mac's hardware. The guest needs a driver (see the guide).";
                        key: "display.video_decode";
                        Toggle {
                            y: (parent.height - self.height) / 2;
                            checked: root.s.video-decode;
                            enabled: !root.lk;
                            toggled(v) => { Bus.set("video_decode", v ? "true" : "false"); }
                        }
                    }
                    Row {
                        label: "Hardware video encoding";
                        tip: "Linux guests: H.264 and HEVC encoded by your Mac's hardware, for video calls and recording. The guest needs a driver (see the guide).";
                        key: "display.video_encode";
                        Toggle {
                            y: (parent.height - self.height) / 2;
                            checked: root.s.video-encode;
                            enabled: !root.lk;
                            toggled(v) => { Bus.set("video_encode", v ? "true" : "false"); }
                        }
                    }
                    Row {
                        label: "Starting size";
                        tip: "The guest's screen when it starts. It follows the window after that.";
                        key: "display.width, height";
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: end;
                            Field {
                                width: 70px;
                                text: root.s.width;
                                mono: true;
                                align: center;
                                input-type: number;
                                enabled: !root.lk;
                                committed(t) => { Bus.set("width", t); }
                            }
                            Text {
                                text: "×";
                                color: Theme.text-3;
                                vertical-alignment: center;
                            }
                            Field {
                                width: 70px;
                                text: root.s.height;
                                mono: true;
                                align: center;
                                input-type: number;
                                enabled: !root.lk;
                                committed(t) => { Bus.set("height", t); }
                            }
                        }
                    }
                }

                if root.vis.storage: SectionCard {
                    icon: Icons.disk;
                    title: "Storage";
                    summary: root.s.sum-storage;
                    force-open: root.open-all;
                    lock-tip: root.lock-tip;
                    for d[i] in root.s.disks: SubCard {
                        HorizontalLayout {
                            spacing: 10px;
                            Icon {
                                source: d.cdrom ? Icons.disc : Icons.disk;
                                y: (parent.height - self.height) / 2;
                                tint: d.missing ? Theme.red : Theme.text-2;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: d.file;
                                        font-size: Theme.fs-md;
                                        font-weight: 600;
                                        color: Theme.text;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: d.missing ? "File not found" : d.size;
                                        font-size: Theme.fs-xs;
                                        color: d.missing ? Theme.red : Theme.text-3;
                                    }
                                }
                                Tip {
                                    text: d.path + (d.used != "" ? "\n" + d.used + " on disk" : "");
                                }
                            }
                            IconButton {
                                icon: Icons.reveal;
                                tip: "Show in Finder";
                                size: 28px;
                                y: (parent.height - self.height) / 2;
                                clicked => { Bus.act("disk." + i + ".reveal"); }
                            }
                            IconButton {
                                icon: d.cdrom ? Icons.x : Icons.trash;
                                tip: d.cdrom ? "Eject" : "Detach (keeps the file)";
                                size: 28px;
                                y: (parent.height - self.height) / 2;
                                enabled: !root.lk;
                                clicked => { Bus.act("disk." + i + ".remove"); }
                            }
                        }
                        if !d.cdrom: Row {
                            label: "Bus";
                            key: "bus";
                            Segmented {
                                width: 150px;
                                options: ["VirtIO", "NVMe"];
                                tips: ["Fastest. Linux has the driver; Windows needs the guest tools.", "Windows setup has this driver built in."];
                                selected: d.bus;
                                enabled: !root.lk;
                                changed(v) => { Bus.set("disk." + i + ".bus", v); }
                            }
                        }
                        if !d.cdrom: Row {
                            label: "Read-only";
                            tip: "The guest can read the disk but not change it.";
                            key: "readonly";
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: d.readonly;
                                enabled: !root.lk;
                                toggled(v) => { Bus.set("disk." + i + ".readonly", v ? "true" : "false"); }
                            }
                        }
                        if !d.cdrom && !d.readonly: Row {
                            label: "Write safety";
                            tip: d.sync == 0 ? "Power cut: survives one. Slow on macOS." : d.sync == 1 ? "Mac crash: survives one, not a power cut." : "None: fast, for scratch disks only.";
                            key: "sync";
                            Select {
                                width: 130px;
                                options: ["Power cut", "Mac crash", "None"];
                                current: d.sync;
                                enabled: !root.lk;
                                selected(v) => { Bus.set("disk." + i + ".sync", v); }
                            }
                        }
                        if d.qcow2 && !d.readonly: Row {
                            label: "Free unused space";
                            tip: "Shrinks the file to what the guest uses. The VM must be off.";
                            Button {
                                small: true;
                                text: "Compact";
                                icon: Icons.broom;
                                has-icon: true;
                                y: (parent.height - self.height) / 2;
                                enabled: !root.lk;
                                clicked => { Bus.act("disk." + i + ".compact"); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Button {
                            small: true;
                            kind: "ghost";
                            text: "New disk";
                            tip: "An empty disk image that grows as it fills";
                            icon: Icons.plus;
                            has-icon: true;
                            enabled: !root.lk;
                            clicked => { Bus.act("disk.add-new"); }
                        }
                        Button {
                            small: true;
                            kind: "ghost";
                            text: "Image";
                            tip: "Attach a disk image you have (qcow2 or raw)";
                            icon: Icons.disk;
                            has-icon: true;
                            enabled: !root.lk;
                            clicked => { Bus.act("disk.add-existing"); }
                        }
                        Button {
                            small: true;
                            kind: "ghost";
                            text: "ISO";
                            tip: "Attach an installer or other CD image";
                            icon: Icons.disc;
                            has-icon: true;
                            enabled: !root.lk;
                            clicked => { Bus.act("disk.add-iso"); }
                        }
                    }
                }

                if root.vis.net: SectionCard {
                    icon: Icons.globe;
                    title: "Network";
                    summary: root.s.sum-net;
                    force-open: root.open-all;
                    lock-tip: root.live-tip;
                    if root.s.net-note != "": Note {
                        text: root.s.net-note;
                    }
                    for n[i] in root.s.nets: NetCard {
                        net: n;
                        index: i;
                        host: root.host;
                        locked: !root.s.live;
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button {
                            small: true;
                            kind: "ghost";
                            text: "Adapter";
                            tip: "Add a network adapter. It comes at the next start.";
                            icon: Icons.plus;
                            has-icon: true;
                            enabled: root.s.live;
                            clicked => { Bus.act("net.add"); }
                        }
                    }
                }

                if root.vis.share: SectionCard {
                    icon: Icons.folder;
                    title: "Shared folders";
                    summary: root.s.sum-share;
                    force-open: root.open-all;
                    lock-tip: root.live-tip;
                    for sh[i] in root.s.shares: SubCard {
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 10px;
                                    Icon {
                                        source: Icons.folder;
                                        y: (parent.height - self.height) / 2;
                                        tint: Theme.text-2;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: sh.short;
                                        font-size: Theme.fs-md;
                                        font-weight: 600;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                                Tip {
                                    text: sh.path;
                                }
                            }
                            IconButton {
                                icon: Icons.copy;
                                tip: "Linux: sudo mount -t virtiofs " + sh.tag + " /mnt. Windows: a drive, Z: first.";
                                size: 28px;
                                y: (parent.height - self.height) / 2;
                                clicked => { Bus.copy("sudo mount -t virtiofs " + sh.tag + " /mnt"); }
                            }
                            IconButton {
                                icon: Icons.trash;
                                tip: "Stop sharing";
                                size: 28px;
                                y: (parent.height - self.height) / 2;
                                enabled: root.s.live;
                                clicked => { Bus.act("share." + i + ".remove"); }
                            }
                        }
                        Row {
                            label: "Name in the guest";
                            tip: "The tag the guest mounts it by.";
                            key: "tag";
                            Field {
                                width: 120px;
                                text: sh.tag;
                                mono: true;
                                enabled: root.s.live;
                                committed(t) => { Bus.set("share." + i + ".tag", t); }
                            }
                        }
                        Row {
                            label: "Guest can change files";
                            tip: "Off: read-only.";
                            key: "readonly = false";
                            warn: !sh.readonly;
                            Toggle {
                                y: (parent.height - self.height) / 2;
                                checked: !sh.readonly;
                                danger: true;
                                enabled: root.s.live;
                                toggled(v) => { Bus.set("share." + i + ".writable", v ? "true" : "false"); }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button {
                            small: true;
                            kind: "ghost";
                            text: "Folder";
                            tip: "Read-only until “Guest can change files” is on.";
                            icon: Icons.plus;
                            has-icon: true;
                            enabled: root.s.live;
                            clicked => { Bus.act("share.add"); }
                        }
                    }
                }

                if root.vis.usb: SectionCard {
                    icon: Icons.usb;
                    title: "USB devices";
                    summary: root.s.sum-usb;
                    force-open: root.open-all || root.s.usb-picking;
                    lock-tip: root.live-tip;
                    if root.s.usb-note != "": Note {
                        text: root.s.usb-note;
                    }
                    // The VM file's devices (a pin: connected at every
                    // start), then those connected for this run only.
                    for u[i] in root.s.usb: VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 6px;
                            min-height: 38px;
                            StatusDot {
                                y: (parent.height - self.height) / 2;
                                tint: u.on ? Theme.green : Theme.border-strong;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    padding-left: 4px;
                                    Text {
                                        text: u.label;
                                        font-size: Theme.fs-md;
                                        color: Theme.text;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: u.note;
                                        font-size: Theme.fs-xs;
                                        color: u.warn ? Theme.amber : Theme.text-3;
                                        overflow: elide;
                                    }
                                }
                                Tip {
                                    text: u.tip;
                                    key: u.pinned ? "[[usb]]" : "";
                                }
                            }
                            IconButton {
                                icon: Icons.pin;
                                tip: u.pinned ? "Always connected: in the VM file. Click to keep it for this run only." : "Always connect: save it in the VM file";
                                tint: u.pinned ? Theme.accent : Theme.text-3;
                                size: 28px;
                                y: (parent.height - self.height) / 2;
                                // Out of the file but connected still: only while it is.
                                enabled: root.s.live && (!u.pinned || u.on);
                                clicked => { Bus.act((u.pinned ? "usb." : "usbnow.") + u.index + (u.pinned ? ".unpin" : ".pin")); }
                            }
                            IconButton {
                                icon: u.pinned ? Icons.trash : Icons.x;
                                tip: u.pinned ? "Remove from the VM" : "Disconnect";
                                size: 28px;
                                y: (parent.height - self.height) / 2;
                                enabled: root.s.live;
                                clicked => { Bus.act((u.pinned ? "usb." : "usbnow.") + u.index + (u.pinned ? ".remove" : ".disconnect")); }
                            }
                        }
                        // A disk: how it goes to the VM (`mode`); connected
                        // now, it connects again that way.
                        if u.storage: Segmented {
                            options: ["Its files", "Whole disk", "USB device"];
                            tips: [
                                "Share its files: the Mac keeps the disk, the VM sees its files as a shared folder.",
                                "Use as a disk: the Mac lets go of it, the VM gets the whole disk to use, format or partition.",
                                "Pass the USB device itself. macOS 15.3 and later refuse this for disks unless vroom-netd has Full Disk Access.",
                            ];
                            selected: u.mode;
                            enabled: root.s.live;
                            changed(m) => { Bus.set((u.pinned ? "usb." : "usbnow.") + u.index + ".mode", m); }
                        }
                    }
                    // What's plugged in, while the list is open (a
                    // repeater: an `if` here wouldn't grow the card).
                    for h[j] in root.s.usb-host: Row {
                        label: h.label;
                        tip: h.note;
                        Button {
                            small: true;
                            text: h.taken ? "Added" : "Add";
                            y: (parent.height - self.height) / 2;
                            enabled: !h.taken && root.s.live;
                            clicked => { Bus.act("usb.pick." + j); }
                        }
                    }
                    if root.s.usb-picking && root.s.usb-host.length == 0: Text {
                        text: "Nothing plugged in";
                        font-size: Theme.fs-sm;
                        color: Theme.text-3;
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button {
                            small: true;
                            kind: "ghost";
                            text: root.s.usb-picking ? "Done" : "Device";
                            tip: root.s.usb-picking ? "" : "Give the VM a device plugged into this Mac. It's taken from the Mac while the VM runs.";
                            icon: root.s.usb-picking ? Icons.check : Icons.plus;
                            has-icon: true;
                            enabled: root.s.live;
                            clicked => { Bus.act("usb.add"); }
                        }
                    }
                }

                if root.vis.sound: SectionCard {
                    icon: Icons.speaker;
                    title: "Sound and camera";
                    summary: root.s.sum-sound;
                    force-open: root.open-all;
                    lock-tip: root.lock-tip;
                    Row {
                        label: "Play guest sound";
                        tip: "Through this Mac's speakers.";
                        key: "audio.output";
                        Toggle {
                            y: (parent.height - self.height) / 2;
                            checked: root.s.audio;
                            enabled: !root.lk;
                            toggled(v) => { Bus.set("audio", v ? "true" : "false"); }
                        }
                    }
                    Row {
                        label: "Microphone";
                        tip: root.s.audio-in ? "The guest hears this Mac's microphone while its window is open and it records. The window shows when." : "For video calls. Off: the guest has no microphone.";
                        key: "audio.input";
                        warn: root.s.audio-in;
                        Toggle {
                            y: (parent.height - self.height) / 2;
                            checked: root.s.audio-in;
                            danger: true;
                            enabled: !root.lk;
                            toggled(v) => { Bus.set("audio.in", v ? "true" : "false"); }
                        }
                    }
                    Row {
                        label: "Camera";
                        tip: root.s.camera ? "The guest sees this Mac's camera as a USB webcam while its window is open and an app uses it. The window shows when." : "For video calls. Off: the guest has no camera.";
                        key: "camera";
                        warn: root.s.camera;
                        Toggle {
                            y: (parent.height - self.height) / 2;
                            checked: root.s.camera;
                            danger: true;
                            enabled: !root.lk;
                            toggled(v) => { Bus.set("camera", v ? "true" : "false"); }
                        }
                    }
                }

                if root.vis.clip: SectionCard {
                    icon: Icons.clipboard;
                    title: "Clipboard";
                    summary: root.s.sum-clip;
                    force-open: root.open-all;
                    Row {
                        label: "Mac to guest";
                        tip: "Only while the VM window has focus.";
                        key: "clipboard.host_to_guest";
                        Toggle {
                            y: (parent.height - self.height) / 2;
                            checked: root.s.clip-in;
                            toggled(v) => { Bus.set("clip.in", v ? "true" : "false"); }
                        }
                    }
                    Row {
                        label: "Guest to Mac";
                        tip: "What the guest copies lands on this Mac's clipboard.";
                        key: "clipboard.guest_to_host";
                        Toggle {
                            y: (parent.height - self.height) / 2;
                            checked: root.s.clip-out;
                            toggled(v) => { Bus.set("clip.out", v ? "true" : "false"); }
                        }
                    }
                    Divider { text: "ADVANCED"; }
                    Row {
                        label: "Size limit";
                        tip: "Text only. Bigger copies are dropped.";
                        key: "clipboard.max_bytes";
                        Field {
                            width: 100px;
                            text: root.s.clip-max-kib;
                            suffix: "KB";
                            mono: true;
                            input-type: number;
                            committed(t) => { Bus.set("clip.max", t); }
                        }
                    }
                }

                if root.vis.tools && root.s.tools-action != "": SectionCard {
                    icon: Icons.package;
                    title: "Guest tools";
                    summary: root.s.tools-have != "" ? root.s.tools-have : "none";
                    force-open: root.open-all;
                    Row {
                        label: root.s.tools-have != "" ? root.s.tools-have : "none";
                        tip: "Agent and drivers: clipboard, resizing, shared folders.";
                        key: "tools";
                        Button {
                            small: true;
                            text: root.s.tools-action;
                            tip: root.s.tools-new != "" ? "→ " + root.s.tools-new : "";
                            y: (parent.height - self.height) / 2;
                            clicked => { Bus.act("tools"); }
                        }
                    }
                }

                if root.vis.security: SectionCard {
                    icon: root.s.sandbox ? Icons.shield : Icons.shield-off;
                    hue: root.s.sandbox ? Theme.green : Theme.red;
                    title: "Security";
                    summary: root.s.sum-security;
                    warn: !root.s.sandbox;
                    force-open: root.open-all;
                    lock-tip: root.lock-tip;
                    Row {
                        label: "Sandbox";
                        tip: root.s.sandbox ? "The VM process can only touch its own files." : "Off: a guest that breaks out gets your user's access.";
                        key: "security.sandbox";
                        warn: !root.s.sandbox;
                        Toggle {
                            y: (parent.height - self.height) / 2;
                            checked: root.s.sandbox;
                            enabled: !root.lk;
                            toggled(v) => { Bus.set("sandbox", v ? "true" : "false"); }
                        }
                    }
                    Row {
                        label: "TPM 2.0";
                        tip: "Windows 11 needs it. Needs swtpm (brew install swtpm).";
                        key: "tpm";
                        Toggle {
                            y: (parent.height - self.height) / 2;
                            checked: root.s.tpm;
                            enabled: !root.lk;
                            toggled(v) => { Bus.set("tpm", v ? "true" : "false"); }
                        }
                    }
                    Divider { text: "ADVANCED"; }
                    Row {
                        label: "Device transport";
                        key: "virtio_transport";
                        Segmented {
                            width: 170px;
                            options: ["Auto", "MMIO", "PCI"];
                            tips: ["PCI with UEFI, MMIO with kernel boot.", "Memory-mapped devices: kernel boot only.", "PCI devices: what UEFI and Windows need."];
                            selected: root.s.transport;
                            enabled: !root.lk;
                            changed(v) => { Bus.set("transport", v); }
                        }
                    }
                    Row {
                        label: "Hardware maker";
                        tip: "What firmware tables and devices tell the guest. ACPI, disk, USB and agent names: [identity] in the config file.";
                        key: "identity.vendor";
                        Field {
                            width: 150px;
                            text: root.s.id-vendor;
                            enabled: !root.lk;
                            committed(t) => { Bus.set("identity.vendor", t); }
                        }
                    }
                    Row {
                        label: "Model";
                        key: "identity.product";
                        Field {
                            width: 150px;
                            text: root.s.id-product;
                            enabled: !root.lk;
                            committed(t) => { Bus.set("identity.product", t); }
                        }
                    }
                    Row {
                        label: "Tell the guest it's a VM";
                        tip: "Off hides the VM flags in the firmware tables. Other signs stay (virtio devices, CPU).";
                        key: "identity.announce_vm";
                        Toggle {
                            y: (parent.height - self.height) / 2;
                            checked: root.s.id-announce;
                            enabled: !root.lk;
                            toggled(v) => { Bus.set("identity.announce", v ? "true" : "false"); }
                        }
                    }
                    Row {
                        label: "Serial numbers";
                        tip: root.s.id-serials;
                        key: "identity.serial, disk_serial";
                        IconButton {
                            icon: Icons.dice;
                            tip: "New random serial numbers";
                            size: 30px;
                            y: (parent.height - self.height) / 2;
                            enabled: !root.lk;
                            clicked => { Bus.act("identity.random"); }
                        }
                    }
                    Row {
                        label: "Serial console";
                        tip: "Terminal: the VM log when started from here.";
                        key: "serial.type";
                        Select {
                            width: 130px;
                            options: ["Terminal", "File", "Off"];
                            current: root.s.serial;
                            enabled: !root.lk;
                            selected(v) => { Bus.set("serial", v); }
                        }
                    }
                }

                if root.vis.boot: SectionCard {
                    icon: Icons.rocket;
                    title: "Boot";
                    summary: root.s.sum-boot;
                    force-open: root.open-all;
                    lock-tip: root.lock-tip;
                    Segmented {
                        options: ["UEFI", "Linux kernel"];
                        tips: ["Firmware boots the disk or installer, like a PC.", "Start a kernel and initrd directly. Fastest; Linux only."];
                        selected: root.s.boot-kernel ? 1 : 0;
                        enabled: !root.lk;
                        changed(v) => { Bus.set("boot.kind", v); }
                    }
                    if !root.s.boot-kernel: Row {
                        label: "Firmware";
                        tip: root.s.firmware == "" ? "Empty: found automatically (Homebrew qemu)." : "";
                        key: "boot.firmware";
                        Field {
                            width: 180px;
                            text: root.s.firmware;
                            placeholder: "automatic";
                            mono: true;
                            enabled: !root.lk;
                            committed(t) => { Bus.set("boot.firmware", t); }
                        }
                    }
                    if !root.s.boot-kernel: Row {
                        label: "NVRAM";
                        tip: root.s.vars;
                        key: "boot.vars";
                    }
                    if root.s.boot-kernel: Row {
                        label: "Kernel";
                        key: "boot.kernel";
                        Field {
                            width: 180px;
                            text: root.s.kernel;
                            mono: true;
                            enabled: !root.lk;
                            committed(t) => { Bus.set("boot.kernel", t); }
                        }
                    }
                    if root.s.boot-kernel: Row {
                        label: "Initrd";
                        key: "boot.initrd";
                        Field {
                            width: 180px;
                            text: root.s.initrd;
                            placeholder: "none";
                            mono: true;
                            enabled: !root.lk;
                            committed(t) => { Bus.set("boot.initrd", t); }
                        }
                    }
                    if root.s.boot-kernel: VerticalLayout {
                        spacing: 4px;
                        Row {
                            label: "Command line";
                            key: "boot.cmdline";
                        }
                        Field {
                            text: root.s.cmdline;
                            mono: true;
                            enabled: !root.lk;
                            committed(t) => { Bus.set("boot.cmdline", t); }
                        }
                    }
                }

                if root.vis.searching && !(root.vis.hw || root.vis.display || root.vis.storage || root.vis.net || root.vis.share || root.vis.usb || root.vis.sound || root.vis.clip || root.vis.security || root.vis.boot): HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: "Nothing matches";
                        font-size: Theme.fs-sm;
                        color: Theme.text-3;
                    }
                    InfoTip {
                        text: "The config file has every option: ⋯ → Open config file.";
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 6px;
                    Button {
                        small: true;
                        kind: "ghost";
                        text: "Config file";
                        tip: root.s.config-path;
                        icon: Icons.file;
                        has-icon: true;
                        clicked => { Bus.act("edit-file"); }
                    }
                }
            }
        }
    }
}
