// Data the Rust side hands to the UI. The UI never changes these
// directly: it calls back with what the user wants, Rust applies it,
// saves the VM file, and pushes the new state.

export enum VmState { off, starting, running, paused, suspending, stopping, suspended }

export struct VmItem {
    id: int,
    name: string,
    os: string,
    state: VmState,
    // "4 CPUs · 8 GB"
    specs: string,
    thumb: image,
    has-thumb: bool,
    // The window is open in this app (we can show it, send commands).
    ours: bool,
    warnings: int,
}

export struct DiskRow {
    file: string,
    path: string,
    // "64 GB" virtual size, and what it takes on the host.
    size: string,
    used: string,
    bus: int,        // 0 virtio, 1 nvme
    sync: int,       // 0 full, 1 fsync, 2 none
    readonly: bool,
    cdrom: bool,
    missing: bool,
    qcow2: bool,
}

export struct ForwardRow {
    host: string,
    guest: string,
    lan: bool,
}

export struct NetRow {
    mode: int,       // 0 nat, 1 bridged, 2 host-only
    interface: string,
    iface-index: int,
    network: string,
    forwards: [ForwardRow],
    loopback: bool,
    block-private: bool,
    mac: string,
    summary: string,
    // The cable is in.
    connected: bool,
    // What of it waits (for the next start, a resume), or why.
    note: string,
}

export struct ShareRow {
    path: string,
    short: string,
    tag: string,
    readonly: bool,
}

// A USB device of the VM: one in its file (`[[usb]]`), or one connected
// to it now for this run only.
export struct UsbRow {
    label: string,
    // Short, on screen: connected, plugged in or not.
    note: string,
    // On hover: ids, how to mount its files by hand.
    tip: string,
    // A disk, and how it goes to the VM: 0 its files, 1 the disk, 2 the
    // device.
    storage: bool,
    mode: int,
    warn: bool,
    // In the VM file: connected at every start. `index` is its place
    // there; else its place in the list of this run's devices.
    pinned: bool,
    index: int,
    // Connected to the running VM now.
    on: bool,
}

// A device plugged into this machine (the Add list).
export struct UsbHostRow {
    label: string,
    note: string,
    taken: bool,    // already in the VM's list
}

export struct SnapRow {
    name: string,
    when: string,
    size: string,
    thumb: image,
    has-thumb: bool,
}

export struct VmSettings {
    loaded: bool,
    name: string,
    os-index: int,
    cpus: int,
    memory-gib: int,
    nested: bool,
    tpm: bool,
    gpu: int,        // 0 none, 1 2d, 2 3d
    opengl: bool,
    opengl-host: int, // 0 apple, 1 angle
    width: string,
    height: string,
    hidpi: bool,
    video-decode: bool,
    monitors: int,
    disks: [DiskRow],
    nets: [NetRow],
    shares: [ShareRow],
    usb: [UsbRow],
    usb-host: [UsbHostRow],
    usb-picking: bool,
    audio: bool,
    audio-in: bool,
    camera: bool,
    clip-in: bool,
    clip-out: bool,
    clip-max-kib: string,
    sandbox: bool,
    id-vendor: string,
    id-product: string,
    id-announce: bool,
    id-serials: string,
    transport: int,  // 0 auto, 1 mmio, 2 pci
    serial: int,     // 0 terminal, 1 file, 2 none
    serial-path: string,
    boot-kernel: bool,
    firmware: string,
    vars: string,
    kernel: string,
    initrd: string,
    cmdline: string,
    warnings: [string],
    // Each warning's first words, for the banner (the rest in its tip).
    warn-short: [string],
    // Running or suspended: hardware can't change.
    locked: bool,
    lock-reason: string,
    // A word or two of it, on screen.
    lock-short: string,
    // Why, in each card that can't change now.
    lock-why: string,
    // Network and USB devices can change now (off, suspended, or running
    // in this app).
    live: bool,
    // What waits in those two cards (adapters removed, the next start).
    net-note: string,
    usb-note: string,
    config-path: string,
    state-path: string,
    snapshots-cpu-mem: string,
    // One-line summaries for the collapsed cards.
    sum-hw: string,
    sum-display: string,
    sum-storage: string,
    sum-net: string,
    sum-share: string,
    sum-usb: string,
    sum-sound: string,
    sum-clip: string,
    sum-security: string,
    sum-boot: string,
}

// Which settings cards match the search box.
export struct CardVis {
    searching: bool,
    hw: bool,
    display: bool,
    storage: bool,
    net: bool,
    share: bool,
    usb: bool,
    sound: bool,
    clip: bool,
    security: bool,
    boot: bool,
}

export struct HostInfo {
    cpus: int,
    memory-gib: int,
    interfaces: [string],
    free: string,
    // vroom-netd, the root helper: "ready", "old", "stopped", "missing",
    // "" (not known yet). Busy: being set up or removed.
    netd: string,
    netd-busy: bool,
}

export struct Toast {
    id: int,
    text: string,
    // 0 info, 1 ok, 2 warning, 3 error
    kind: int,
    action: string,
}

export struct PaletteItem {
    title: string,
    hint: string,
    icon: string,
    action: string,
}

export struct NewVm {
    os-index: int,
    name: string,
    installer: string,
    cpus: int,
    memory-gib: int,
    disk-gib: int,
    gpu3d: bool,
    start: bool,
    // Ready-made (Ubuntu from its cloud image, Windows from its ISO): the
    // account, SSH with a key of ~/.ssh, Ubuntu's desktop.
    ready: bool,
    user: string,
    password: string,
    ssh: bool,
    ssh-key: int,
    desktop: bool,
}
