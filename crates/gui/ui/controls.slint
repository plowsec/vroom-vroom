// Small building blocks. Same look everywhere, no std-widgets styling.

import { Theme, OsLook } from "theme.slint";
import { Icons } from "icons.slint";

export component Icon inherits Image {
    in property <color> tint: Theme.text;
    width: 18px;
    height: 18px;
    colorize: tint;
    image-fit: contain;
}

export component Spinner inherits Rectangle {
    in property <color> tint: Theme.text-2;
    in property <bool> spinning: true;
    width: 16px;
    height: 16px;
    Rectangle {
        // Only runs while a spinner is on screen.
        transform-rotation: root.spinning ? mod(animation-tick() / 2.4ms, 360) * 1deg : 0deg;
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M 12 3 A 9 9 0 1 1 3 12";
            stroke: root.tint;
            stroke-width: 2.5px;
            fill: transparent;
        }
    }
}

// Buttons. kind: "primary" (gradient), "secondary", "ghost", "danger".
export component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <string> kind: "secondary";
    in property <bool> enabled: true;
    in property <bool> small: false;
    in property <bool> busy: false;
    callback clicked;

    height: small ? 28px : 36px;
    min-width: layout.preferred-width;
    border-radius: small ? 8px : 10px;
    opacity: enabled ? 1 : 0.45;
    background: kind == "primary" ? Theme.accent-grad
        : kind == "danger" ? (ta.has-hover ? Theme.red.with-alpha(0.28) : Theme.red-soft)
        : kind == "ghost" ? (ta.has-hover ? Theme.card-hover : transparent)
        : (ta.has-hover ? Theme.card-hover : Theme.card);
    border-width: kind == "primary" || kind == "ghost" ? 0px : 1px;
    border-color: kind == "danger" ? Theme.red.with-alpha(0.3) : Theme.border;
    drop-shadow-blur: kind == "primary" && enabled ? (ta.has-hover ? 22px : 14px) : 0px;
    drop-shadow-color: kind == "primary" ? Theme.accent.with-alpha(0.45) : transparent;
    drop-shadow-offset-y: kind == "primary" ? 4px : 0px;
    animate drop-shadow-blur { duration: 180ms; }

    // Glossy top edge on the primary button.
    if kind == "primary": Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height / 2;
        border-radius: root.border-radius - 1px;
        background: @linear-gradient(180deg, #ffffff38 0%, #ffffff00 100%);
    }
    layout := HorizontalLayout {
        padding-left: root.small ? 10px : 14px;
        padding-right: root.small ? 10px : 16px;
        spacing: 7px;
        alignment: center;
        if root.busy: Spinner {
            y: (parent.height - self.height) / 2;
            tint: root.kind == "primary" ? Theme.on-accent : Theme.text-2;
        }
        if root.has-icon && !root.busy: Icon {
            source: root.icon;
            y: (parent.height - self.height) / 2;
            width: root.small ? 14px : 16px;
            height: self.width;
            tint: root.kind == "primary" ? Theme.on-accent : root.kind == "danger" ? Theme.red : Theme.text;
        }
        if root.text != "": Text {
            text: root.text;
            vertical-alignment: center;
            font-size: root.small ? Theme.fs-sm : Theme.fs-md;
            font-weight: 600;
            color: root.kind == "primary" ? Theme.on-accent : root.kind == "danger" ? Theme.red : Theme.text;
        }
    }
    ta := TouchArea {
        enabled: root.enabled && !root.busy;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    states [
        pressed when ta.pressed: { opacity: 0.8; }
    ]
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tip;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <color> tint: Theme.text-2;
    in property <length> size: 34px;
    callback clicked;
    width: size;
    height: size;
    border-radius: size / 3.4;
    background: active ? Theme.accent-soft : ta.has-hover ? Theme.card-hover : transparent;
    animate background { duration: 120ms; }
    opacity: enabled ? 1 : 0.35;
    Icon {
        source: root.icon;
        width: root.size * 0.5;
        height: self.width;
        tint: root.active ? Theme.accent-text : ta.has-hover ? Theme.text : root.tint;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if ta.has-hover && root.tip != "": Rectangle {
        y: root.height + 6px;
        x: (root.width - self.width) / 2;
        width: tiptext.preferred-width + 16px;
        height: 24px;
        border-radius: 6px;
        background: Theme.popup;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 10px;
        drop-shadow-color: #0000004d;
        tiptext := Text {
            text: root.tip;
            font-size: Theme.fs-xs;
            color: Theme.text;
        }
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    callback toggled(bool);
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: checked ? (danger ? Theme.red : Theme.accent) : Theme.border-strong;
    animate background { duration: 180ms; }
    opacity: enabled ? 1 : 0.4;
    knob := Rectangle {
        width: 18px;
        height: 18px;
        y: 2px;
        x: root.checked ? root.width - self.width - 2px : 2px;
        border-radius: 9px;
        background: #ffffff;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 1px;
        animate x { duration: 180ms; easing: ease-out; }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    in property <bool> enabled: true;
    callback changed(int);
    height: 32px;
    min-width: 60px * options.length;
    border-radius: 9px;
    background: Theme.well;
    border-width: 1px;
    border-color: Theme.border;
    opacity: enabled ? 1 : 0.5;
    property <length> seg: (self.width - 4px) / max(1, options.length);
    Rectangle {
        x: 2px + root.selected * root.seg;
        y: 2px;
        width: root.seg;
        height: root.height - 4px;
        border-radius: 7px;
        background: Theme.card-strong;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000030;
        animate x { duration: 220ms; easing: ease-out; }
    }
    for o[i] in root.options: Rectangle {
        x: 2px + i * root.seg;
        y: 0;
        width: root.seg;
        height: root.height;
        Text {
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: o;
            font-size: Theme.fs-sm;
            font-weight: i == root.selected ? 600 : 500;
            color: i == root.selected ? Theme.text : Theme.text-2;
            overflow: elide;
        }
        TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                if root.selected != i {
                    root.selected = i;
                    root.changed(i);
                }
            }
        }
    }
}

export component Slider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in-out property <float> value;
    in property <bool> enabled: true;
    // Shaded "recommended" range.
    in property <float> sweet-max: maximum;
    in property <string> unit;
    callback released(float);
    height: 26px;
    opacity: enabled ? 1 : 0.45;
    property <float> ratio: (value - minimum) / max(0.0001, maximum - minimum);
    property <length> knob-x: (root.width - 18px) * max(0, min(1, ratio));
    track := Rectangle {
        y: (root.height - 6px) / 2;
        height: 6px;
        border-radius: 3px;
        background: Theme.well;
        border-width: 1px;
        border-color: Theme.border;
    }
    if root.sweet-max < root.maximum: Rectangle {
        x: (root.width - 18px) * (root.sweet-max - root.minimum) / max(0.0001, root.maximum - root.minimum) + 9px;
        y: track.y;
        height: 6px;
        width: root.width - self.x;
        border-radius: 3px;
        background: Theme.amber.with-alpha(0.22);
    }
    Rectangle {
        x: 0;
        y: track.y;
        height: 6px;
        width: root.knob-x + 9px;
        border-radius: 3px;
        background: Theme.accent-grad;
    }
    Rectangle {
        x: root.knob-x;
        y: (root.height - 18px) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
        drop-shadow-blur: ta.has-hover || ta.pressed ? 10px : 4px;
        drop-shadow-color: ta.pressed ? Theme.accent.with-alpha(0.7) : #00000059;
        animate drop-shadow-blur { duration: 150ms; }
    }
    if ta.pressed: Rectangle {
        x: root.knob-x + 9px - self.width / 2;
        y: -26px;
        width: bubble.preferred-width + 14px;
        height: 22px;
        border-radius: 6px;
        background: Theme.popup;
        border-width: 1px;
        border-color: Theme.border;
        bubble := Text {
            text: round(root.value) + " " + root.unit;
            font-size: Theme.fs-xs;
            font-weight: 600;
            color: Theme.text;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down {
                root.set-from(self.mouse-x);
            }
            if ev.kind == PointerEventKind.up {
                root.released(root.value);
            }
        }
        moved => {
            if self.pressed {
                root.set-from(self.mouse-x);
            }
        }
    }
    function set-from(x: length) {
        let r = max(0, min(1, (x - 9px) / max(1px, root.width - 18px)));
        let v = root.minimum + r * (root.maximum - root.minimum);
        root.value = max(root.minimum, min(root.maximum, round(v / root.step) * root.step));
    }
}

// Text box. `committed` fires on Enter and when focus leaves.
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> mono: false;
    in property <bool> enabled: true;
    in property <string> prefix;
    in property <string> suffix;
    in property <InputType> input-type: InputType.text;
    in property <TextHorizontalAlignment> align: TextHorizontalAlignment.left;
    out property <bool> has-focus: input.has-focus;
    callback committed(string);
    callback edited(string);
    callback key-pressed(KeyEvent) -> EventResult;
    height: 34px;
    border-radius: 9px;
    background: input.has-focus ? Theme.field-focus : Theme.field;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    animate border-color { duration: 150ms; }
    opacity: enabled ? 1 : 0.55;
    public function focus-input() {
        input.focus();
    }
    public function select-all() {
        input.select-all();
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 4px;
        if root.prefix != "": Text {
            text: root.prefix;
            vertical-alignment: center;
            font-size: Theme.fs-md;
            color: Theme.text-3;
            font-family: root.mono ? Theme.mono : "";
        }
        Rectangle {
            horizontal-stretch: 1;
            input := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.text;
                vertical-alignment: center;
                horizontal-alignment: root.align;
                font-size: Theme.fs-md;
                font-family: root.mono ? Theme.mono : "";
                color: Theme.text;
                selection-background-color: Theme.accent.with-alpha(0.4);
                selection-foreground-color: Theme.text;
                single-line: true;
                enabled: root.enabled;
                input-type: root.input-type;
                accepted => { root.committed(self.text); }
                edited => { root.edited(self.text); }
                changed has-focus => {
                    if !self.has-focus {
                        root.committed(self.text);
                    }
                }
            }
            if root.text == "": Text {
                width: 100%;
                height: 100%;
                text: root.placeholder;
                vertical-alignment: center;
                horizontal-alignment: root.align;
                font-size: Theme.fs-md;
                color: Theme.text-3;
                font-family: root.mono ? Theme.mono : "";
                overflow: elide;
            }
        }
        if root.suffix != "": Text {
            text: root.suffix;
            vertical-alignment: center;
            font-size: Theme.fs-md;
            color: Theme.text-3;
        }
    }
}

export component Select inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    in property <bool> enabled: true;
    in property <string> empty-text: "None";
    callback selected(int);
    height: 34px;
    min-width: 120px;
    border-radius: 9px;
    background: ta.has-hover ? Theme.card-hover : Theme.field;
    border-width: 1px;
    border-color: Theme.border;
    opacity: enabled ? 1 : 0.5;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        Text {
            horizontal-stretch: 1;
            text: root.current >= 0 && root.current < root.options.length ? root.options[root.current] : root.empty-text;
            vertical-alignment: center;
            font-size: Theme.fs-md;
            color: Theme.text;
            overflow: elide;
        }
        Icon {
            source: Icons.chevron-down;
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            tint: Theme.text-3;
        }
    }
    ta := TouchArea {
        enabled: root.enabled && root.options.length > 0;
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: max(root.width, 160px);
        Rectangle {
            background: Theme.popup;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000066;
            drop-shadow-offset-y: 8px;
            VerticalLayout {
                padding: 4px;
                for o[i] in root.options: Rectangle {
                    height: 30px;
                    border-radius: 7px;
                    background: ita.has-hover ? Theme.accent-soft : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            horizontal-stretch: 1;
                            text: o;
                            vertical-alignment: center;
                            font-size: Theme.fs-md;
                            color: i == root.current ? Theme.accent-text : Theme.text;
                            font-weight: i == root.current ? 600 : 400;
                        }
                        if i == root.current: Icon {
                            source: Icons.check;
                            width: 14px;
                            height: 14px;
                            y: (parent.height - self.height) / 2;
                            tint: Theme.accent-text;
                        }
                    }
                    ita := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current = i;
                            root.selected(i);
                        }
                    }
                }
            }
        }
    }
}

export component Chip inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <color> tint: Theme.text-2;
    height: 30px;
    min-width: l.preferred-width;
    border-radius: 15px;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.border;
    l := HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 6px;
        Icon {
            source: root.icon;
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            tint: root.tint;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Theme.fs-sm;
            font-weight: 500;
            color: Theme.text;
        }
    }
}

export component StatusDot inherits Rectangle {
    in property <color> tint;
    in property <bool> glow: false;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: tint;
    drop-shadow-blur: glow ? 8px : 0px;
    drop-shadow-color: tint;
}

export component OsBadge inherits Rectangle {
    in property <string> os;
    in property <length> size: 32px;
    in property <bool> glow: false;
    width: size;
    height: size;
    border-radius: size * 0.3;
    background: OsLook.grad(os);
    drop-shadow-blur: glow ? size * 0.5 : 0px;
    drop-shadow-color: OsLook.glow(os).with-alpha(0.55);
    drop-shadow-offset-y: glow ? size * 0.12 : 0px;
    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height * 0.5;
        border-radius: root.border-radius - 1px;
        background: @linear-gradient(180deg, #ffffff40 0%, #ffffff00 100%);
    }
    Icon {
        source: Icons.os(root.os);
        width: root.size * 0.56;
        height: self.width;
        tint: #ffffff;
    }
}

// A labelled line in a settings card. The config key shows on hover, so
// people learn the file without a second UI for it.
export component Row inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <string> key;
    in property <bool> warn: false;
    min-height: max(38px, l.preferred-height);
    hover := TouchArea { }
    l := HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.label;
                    font-size: Theme.fs-md;
                    color: root.warn ? Theme.amber : Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if hover.has-hover && root.key != "": Text {
                    text: root.key;
                    font-size: 10px;
                    font-family: Theme.mono;
                    color: Theme.accent-text;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            if root.hint != "": Text {
                text: root.hint;
                font-size: Theme.fs-xs;
                color: Theme.text-3;
                wrap: word-wrap;
            }
        }
        @children
    }
}

// Collapsible settings card.
export component SectionCard inherits Rectangle {
    in property <image> icon;
    in property <color> hue;
    in property <string> title;
    in property <string> summary;
    in property <bool> warn: false;
    in-out property <bool> expanded: false;
    // Search results open their cards without touching `expanded`.
    in property <bool> force-open: false;
    property <bool> open: expanded || force-open;
    border-radius: Theme.r-lg;
    background: header-ta.has-hover && !open ? Theme.card-hover : Theme.card;
    border-width: 1px;
    border-color: open ? Theme.border-strong : Theme.border;
    animate background { duration: 120ms; }
    clip: true;
    VerticalLayout {
        header := Rectangle {
            height: 62px;
            header-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.expanded = !root.expanded; }
            }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                Rectangle {
                    width: 34px;
                    height: 34px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 10px;
                    background: root.hue.with-alpha(0.16);
                    border-width: 1px;
                    border-color: root.hue.with-alpha(0.22);
                    Icon {
                        source: root.icon;
                        tint: root.hue;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.title;
                        font-size: Theme.fs-md;
                        font-weight: 600;
                        color: Theme.text;
                    }
                    Text {
                        text: root.summary;
                        font-size: Theme.fs-sm;
                        color: root.warn ? Theme.amber : Theme.text-2;
                        overflow: elide;
                    }
                }
                if root.warn: Icon {
                    source: Icons.warning;
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    tint: Theme.amber;
                }
                Icon {
                    source: Icons.chevron-down;
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    tint: Theme.text-3;
                    transform-rotation: root.open ? 180deg : 0deg;
                    animate transform-rotation { duration: 220ms; easing: ease-out; }
                }
            }
        }
        body := Rectangle {
            height: root.open ? inner.preferred-height : 0px;
            animate height { duration: 240ms; easing: ease-out; }
            clip: true;
            inner := VerticalLayout {
                y: 0;
                width: parent.width;
                height: self.preferred-height;
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 14px;
                spacing: 6px;
                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }
                @children
            }
        }
    }
}

// Small caps divider inside a card ("Advanced").
export component Divider inherits Rectangle {
    in property <string> text;
    height: 26px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.text;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.8px;
            color: Theme.text-3;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
        }
    }
}

export component Banner inherits Rectangle {
    in property <string> text;
    in property <int> kind: 2; // 1 ok, 2 warning, 3 error, 0 info
    in property <image> icon: kind == 3 ? Icons.warning : kind == 2 ? Icons.warning : kind == 1 ? Icons.check : Icons.info;
    property <color> c: kind == 3 ? Theme.red : kind == 2 ? Theme.amber : kind == 1 ? Theme.green : Theme.blue;
    min-height: l.preferred-height;
    border-radius: 12px;
    background: c.with-alpha(0.10);
    border-width: 1px;
    border-color: c.with-alpha(0.25);
    l := HorizontalLayout {
        padding: 10px;
        padding-left: 12px;
        spacing: 10px;
        Icon {
            source: root.icon;
            width: 16px;
            height: 16px;
            tint: root.c;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Text {
                text: root.text;
                wrap: word-wrap;
                font-size: Theme.fs-sm;
                color: Theme.text;
            }
        }
        @children
    }
}
