// Design tokens. Every color, radius and size comes from here, so the
// light and dark themes are one switch. Flat and neutral on purpose:
// color means something (running, warning, danger, the one main action).

export global Theme {
    // Set from Rust: follows the system unless the user picked one.
    in-out property <bool> dark: true;

    // Surfaces
    out property <color> bg: dark ? #18181a : #f6f6f5;
    out property <color> bg-raised: dark ? #1e1e21 : #ffffff;
    out property <color> sidebar: dark ? #141416 : #ededec;
    out property <color> card: dark ? #212124 : #ffffff;
    out property <color> card-hover: dark ? #27272b : #fafafa;
    out property <color> card-strong: dark ? #2b2b2f : #ffffff;
    out property <color> well: dark ? #19191b : #f1f1f0;
    out property <color> field: dark ? #19191b : #ffffff;
    out property <color> field-focus: dark ? #1b1b1d : #ffffff;
    out property <color> selected: dark ? #ffffff14 : #0000000f;
    out property <color> scrim: dark ? #00000099 : #00000040;
    out property <color> popup: dark ? #2a2a2e : #ffffff;

    // Lines
    out property <color> border: dark ? #ffffff14 : #00000017;
    out property <color> border-strong: dark ? #ffffff24 : #00000026;

    // Text
    out property <color> text: dark ? #ececec : #1c1c1e;
    out property <color> text-2: dark ? #a1a1a6 : #5a5a5f;
    out property <color> text-3: dark ? #707075 : #8e8e93;
    out property <color> on-accent: #ffffff;

    // The one accent: the main button, toggles, focus.
    out property <color> accent: dark ? #3b82f6 : #2563eb;
    out property <color> accent-text: dark ? #7aa7f7 : #1d4ed8;

    // Status
    out property <color> green: dark ? #4ade80 : #16a34a;
    out property <color> amber: dark ? #fbbf24 : #b45309;
    out property <color> red: dark ? #f87171 : #dc2626;
    out property <color> blue: dark ? #60a5fa : #2563eb;
    out property <color> red-soft: dark ? #f8717124 : #dc262614;

    // Shape
    out property <length> r-sm: 6px;
    out property <length> r-md: 8px;
    out property <length> r-lg: 10px;
    out property <length> r-xl: 12px;

    // Type
    out property <length> fs-xs: 11px;
    out property <length> fs-sm: 12px;
    out property <length> fs-md: 13px;
    out property <length> fs-lg: 15px;
    out property <length> fs-xl: 18px;
    out property <length> fs-hero: 22px;
    out property <string> mono: "Menlo";
}

// Each guest OS's own color, used on its icon only.
export global OsLook {
    public pure function color(os: string) -> color {
        if os == "windows" { return #0078d4; }
        if os == "ubuntu" { return #e95420; }
        if os == "debian" { return #d70a53; }
        if os == "fedora" { return #3c6eb4; }
        if os == "alpine" { return #0d597f; }
        if os == "linux" { return #c08a00; }
        return #8e8e93;
    }
    public pure function label(os: string) -> string {
        if os == "windows" { return "Windows"; }
        if os == "ubuntu" { return "Ubuntu"; }
        if os == "debian" { return "Debian"; }
        if os == "fedora" { return "Fedora"; }
        if os == "alpine" { return "Alpine"; }
        if os == "linux" { return "Linux"; }
        return "Other";
    }
}
